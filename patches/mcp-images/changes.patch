+const { createServer } = require('node:http');
+const { once } = require('node:events');
+const { createHash, randomUUID } = require('node:crypto');
+const { setImmediate } = require('node:timers/promises');
+const mongoose = require('mongoose');
+const { MongoMemoryServer } = require('mongodb-memory-server');
+const sharp = require('sharp');
+const { OpenAI } = require('openai');
+const { Run } = require('@librechat/agents');
+const { Command } = require('@langchain/langgraph');
+const { createModels, getRequestId, logger, tenantStorage } = require('@librechat/data-schemas');
+const { CallToolResultSchema } = require('@modelcontextprotocol/sdk/types.js');
+const {
+  createToolExecuteHandler,
+  createStreamServices,
+  GenerationJobManager,
+  getAgentCheckpointer,
+  getProviderConfig,
+  LazyMongoSaver,
+  MCPConnection,
+  MCPManager,
+  MCPServersRegistry,
+} = require('@librechat/api');
+const { Constants, Permissions, PermissionTypes } = require('librechat-data-provider');
+const { getMCPManager, getMCPServersRegistry } = require('~/config');
+const db = require('~/models');
+const { getAppConfig, getMCPServerTools } = require('~/server/services/Config');
+const { getEndpointModelsConfig } = require('~/server/controllers/ModelController');
+const { saveBase64Image } = require('~/server/services/Files/process');
+const { createMCPTool } = require('~/server/services/MCP');
+const { initializeClient } = require('./initialize');
+
+jest.mock('~/config', () => ({
+  ...jest.requireActual('~/config'),
+  getMCPManager: jest.fn(),
+  getMCPServersRegistry: jest.fn(),
+}));
+jest.mock('~/models', () => ({
+  ...jest.requireActual('~/models'),
+  findPluginAuthsByKeys: jest.fn(async () => []),
+  getRoleByName: jest.fn(),
+}));
+jest.mock('~/server/controllers/ModelController', () => ({
+  getEndpointModelsConfig: jest.fn(),
+}));
+jest.mock('~/server/services/Config', () => ({
+  ...jest.requireActual('~/server/services/Config'),
+  getAppConfig: jest.fn(),
+  getMCPServerTools: jest.fn(),
+}));
+jest.mock('~/server/services/Files/process', () => ({
+  ...jest.requireActual('~/server/services/Files/process'),
+  saveBase64Image: jest.fn(),
+}));
+
+const responsesModel = 'gpt-6.2-sol';
+const moonshotModel = 'moonshot-v1-8k';
+const toolKey = `screenshot${Constants.mcp_delimiter}synthetic`;
+const callId = 'call_synthetic';
+const askTool = 'ask_user_question';
+const mongoCheckpointer = { type: 'mongo', ttl: 3600 };
+const photoText = 'Synthetic screenshot is ready.';
+const endText = 'Finished synthetic tool call.';
+const prompt = 'Run the screenshot tool.';
+const toolDefinition = {
+  type: 'function',
+  function: {
+    name: toolKey,
+    description: 'Return a synthetic screenshot',
+    parameters: { type: 'object', properties: {} },
+  },
+};
+
+function writeResponsesStream(res, model, isFirstRequest, call, sequence = 0) {
+  const calls = Array.isArray(call) ? call : isFirstRequest || call != null ? [call] : [];
+  const items =
+    calls.length > 0
+      ? calls.map((fields, index) => ({
+          type: 'function_call',
+          id: `fc_synthetic_${sequence}_${index}`,
+          call_id: callId,
+          name: toolKey,
+          arguments: '{}',
+          ...fields,
+        }))
+      : [
+          {
+            type: 'message',
+            id: 'msg_synthetic',
+            role: 'assistant',
+            content: [{ type: 'output_text', text: endText, annotations: [] }],
+          },
+        ];
+  const responseId = isFirstRequest ? 'resp_tool' : 'resp_final';
+  const response = {
+    id: sequence ? `resp_synthetic_${sequence}` : responseId,
+    object: 'response',
+    model,
+    status: 'in_progress',
+    output: [],
+  };
+  const events = [{ type: 'response.created', response }];
+  for (const [index, item] of items.entries()) {
+    if (item.type === 'function_call') {
+      events.push(
+        {
+          type: 'response.output_item.added',
+          output_index: index,
+          item: { ...item, arguments: '' },
+        },
+        {
+          type: 'response.function_call_arguments.delta',
+          output_index: index,
+          item_id: item.id,
+          delta: item.arguments,
+        },
+      );
+      continue;
+    }
+    events.push({
+      type: 'response.output_text.delta',
+      output_index: index,
+      content_index: 0,
+      item_id: item.id,
+      delta: endText,
+    });
+  }
+  events.push({
+    type: 'response.completed',
+    response: {
+      ...response,
+      status: 'completed',
+      output: items.map((item) => ({ ...item, status: 'completed' })),
+      usage: { input_tokens: 10, output_tokens: 5, total_tokens: 15 },
+    },
+  });
+  res.writeHead(200, { 'Content-Type': 'text/event-stream' });
+  res.end(
+    events.map((event) => `event: ${event.type}\ndata: ${JSON.stringify(event)}\n\n`).join(''),
+  );
+}
+
+function writeChatStream(res, model, isFirstRequest) {
+  const delta = isFirstRequest
+    ? {
+        tool_calls: [
+          { index: 0, id: callId, type: 'function', function: { name: toolKey, arguments: '{}' } },
+        ],
+      }
+    : { content: endText };
+  const chunk = {
+    id: isFirstRequest ? 'chat_tool' : 'chat_final',
+    object: 'chat.completion.chunk',
+    model,
+    choices: [{ index: 0, delta: { role: 'assistant', ...delta }, finish_reason: null }],
+  };
+  const done = {
+    ...chunk,
+    choices: [{ index: 0, delta: {}, finish_reason: isFirstRequest ? 'tool_calls' : 'stop' }],
+  };
+  res.writeHead(200, { 'Content-Type': 'text/event-stream' });
+  res.end(`data: ${JSON.stringify(chunk)}\n\ndata: ${JSON.stringify(done)}\n\ndata: [DONE]\n\n`);
+}
+
+function inputParts(input) {
+  return input.flatMap((item) => [
+    item,
+    ...[item.content, item.output].filter(Array.isArray).flat(),
+  ]);
+}
+
+const outputOf = (body, id) =>
+  body.input.find(({ type, call_id }) => type === 'function_call_output' && call_id === id)?.output;
+const imageParts = (body) => inputParts(body.input).filter(({ type }) => type === 'input_image');
+const imageRefOf = (body) =>
+  String(outputOf(body, callId)).match(/\[(img_[A-Za-z0-9_-]{16})\]/)?.[1];
+
+function captureDiagnostics(expectedImages = 0) {
+  const requests = [];
+  const images = [];
+  const attempts = [];
+  const { promise, resolve } = Promise.withResolvers();
+  logger.info.mockImplementation((message, fields) => {
+    const event = { message, ...fields, request_id: getRequestId() };
+    if (message === 'openai.responses.request') {
+      requests.push(event);
+    } else if (message === 'openai.responses.http_attempt') {
+      attempts.push(event);
+    } else if (message === 'mcp.tool.image' || message === 'openai.responses.input_image') {
+      images.push(event);
+      if (images.length === expectedImages) {
+        resolve();
+      }
+    }
+  });
+  return { requests, images, attempts, ready: expectedImages > 0 ? promise : undefined };
+}
+
+describe('MCP images in the next Agent model request', () => {
+  let png;
+  let pngBytes;
+  let server;
+  let baseURL;
+  let requests;
+  let unexpectedRequests;
+  let connection;
+  let callTool;
+  let image;
+  let serverConfig;
+  let config;
+  let respondToResponses;
+  let requestLimit;
+
+  async function createLoopbackClient(options = {}) {
+    const { getOptions, customEndpointConfig } = getProviderConfig({
+      provider: 'NewAPI',
+      appConfig: config,
+    });
+    const { configOptions } = await getOptions({
+      req: { user: { id: 'synthetic-user' }, body: {}, config },
+      endpoint: 'NewAPI',
+      model_parameters: { model: responsesModel, useResponsesApi: true },
+      customEndpointConfig,
+    });
+    expect(configOptions?.baseURL === baseURL).toBe(true);
+    return new OpenAI({ ...configOptions, apiKey: 'synthetic-api-key', maxRetries: 0, ...options });
+  }
+
+  let mongoServer;
+  beforeAll(async () => {
+    mongoServer = await MongoMemoryServer.create();
+    await mongoose.connect(mongoServer.getUri());
+    createModels(mongoose);
+    GenerationJobManager.configure({ ...createStreamServices(), cleanupOnComplete: false });
+    GenerationJobManager.initialize();
+    pngBytes = await sharp({ create: { width: 3, height: 2, channels: 3, background: '#4287ab' } })
+      .png()
+      .toBuffer();
+    png = pngBytes.toString('base64');
+    image = { type: 'image', mimeType: 'image/png', data: png };
+    server = createServer(async (req, res) => {
+      const isResponses = req.url === '/v1/responses';
+      if (
+        req.method !== 'POST' ||
+        (!isResponses && req.url !== '/v1/chat/completions') ||
+        requests.length >= requestLimit
+      ) {
+        unexpectedRequests++;
+        res.writeHead(400).end();
+        return;
+      }
+      const chunks = [];
+      for await (const chunk of req) {
+        chunks.push(chunk);
+      }
+      const body = JSON.parse(Buffer.concat(chunks));
+      requests.push({ method: req.method, path: req.url, body });
+      if (isResponses && respondToResponses) {
+        respondToResponses(req, res, requests.length);
+        return;
+      }
+      const writeStream = isResponses ? writeResponsesStream : writeChatStream;
+      writeStream(res, body.model, requests.length === 1);
+    });
+    server.listen(0, '127.0.0.1');
+    await once(server, 'listening');
+    baseURL = `http://127.0.0.1:${server.address().port}/v1`;
+  }, 60_000);
+
+  afterAll(async () => {
+    if (server?.listening) {
+      const closed = once(server, 'close');
+      server.close();
+      server.closeAllConnections();
+      await closed;
+    }
+    await GenerationJobManager.destroy();
+    await mongoose.disconnect();
+    await mongoServer?.stop();
+  });
+
+  beforeEach(() => {
+    requests = [];
+    unexpectedRequests = 0;
+    requestLimit = 2;
+    respondToResponses = undefined;
+    serverConfig = { type: 'streamable-http', url: `${baseURL}/mcp` };
+    const registry = new MCPServersRegistry(mongoose, ['127.0.0.1'], ['127.0.0.1'], async () => ({
+      allowedDomains: ['127.0.0.1'],
+      allowedAddresses: ['127.0.0.1'],
+      mcpApps: registry.getMCPAppsPolicy(),
+      serverNames: ['synthetic'],
+    }));
+    registry.setYamlServerOptions({ synthetic: serverConfig });
+    jest.spyOn(registry, 'getServerConfig').mockImplementation(async (name) => {
+      return name === 'synthetic' ? serverConfig : undefined;
+    });
+    jest.spyOn(registry, 'getAllServerConfigs').mockResolvedValue({ synthetic: serverConfig });
+    jest.spyOn(registry, 'isAppServerConfig').mockResolvedValue(false);
+    jest.spyOn(registry, 'ensureConfigServers').mockResolvedValue({});
+    jest.spyOn(MCPServersRegistry, 'getInstance').mockReturnValue(registry);
+    getMCPServersRegistry.mockReturnValue(registry);
+    const manager = new MCPManager();
+    connection = new MCPConnection({ serverName: 'synthetic', serverConfig });
+    jest.spyOn(connection, 'isConnected').mockResolvedValue(true);
+    jest.spyOn(manager, 'getConnection').mockResolvedValue(connection);
+    callTool = jest.spyOn(manager, 'callTool');
+    getMCPManager.mockReturnValue(manager);
+    config = {
+      endpoints: {
+        agents: {
+          capabilities: ['tools'],
+          toolApproval: { enabled: false },
+          checkpointer: { enabled: false },
+        },
+        custom: [
+          {
+            name: 'NewAPI',
+            baseURL,
+            apiKey: 'test',
+            models: { default: [responsesModel], fetch: false },
+          },
+          {
+            name: 'Moonshot',
+            baseURL,
+            apiKey: 'test',
+            models: { default: [moonshotModel], fetch: false },
+          },
+        ],
+      },
+      mcpConfig: { synthetic: serverConfig },
+      mcpSettings: { allowedDomains: ['127.0.0.1'], allowedAddresses: ['127.0.0.1'] },
+      summarization: { enabled: false },
+      balance: { enabled: false },
+      transactions: { enabled: false },
+    };
+    getAppConfig.mockResolvedValue(config);
+    db.getRoleByName.mockResolvedValue({
+      permissions: { [PermissionTypes.MCP_SERVERS]: { [Permissions.USE]: true } },
+    });
+    getMCPServerTools.mockResolvedValue({ [toolKey]: toolDefinition });
+    saveBase64Image.mockClear().mockResolvedValue({
+      file_id: 'synthetic-file',
+      type: 'image/png',
+      width: 2,
+      height: 2,
+      filepath: '/synthetic.png',
+    });
+  });
+
+  afterEach(() => {
+    logger.info.mockReset();
+    jest.restoreAllMocks();
+  });
+
+  test('foreground Responses can read an original MCP image with the user-question saver attached', async () => {
+    const textTool = `status${Constants.mcp_delimiter}synthetic`;
+    const textResult = 'Synthetic follow-up status';
+    const callIds = [callId, 'call_text_1', 'call_read', 'call_text_2'];
+    const textDefinition = {
+      ...toolDefinition,
+      function: { ...toolDefinition.function, name: textTool, description: 'Return text only' },
+    };
+    getMCPServerTools.mockResolvedValue({ [toolKey]: toolDefinition, [textTool]: textDefinition });
+    config.endpoints.agents.mcpImageRead = true;
+    config.endpoints.agents.checkpointer = mongoCheckpointer;
+    config.endpoints.agents.capabilities.push(askTool);
+    const createRun = jest.spyOn(Run, 'create');
