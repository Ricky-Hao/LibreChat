+import { GraphInterrupt } from '@langchain/langgraph';
+import type { SubagentResolutionDiagnostic } from '@librechat/agents';
+import {
+  createSubagentResolutionFailureHandler,
+  SubagentInitializationError,
+  validateSelectedSubagent,
+  withInitializationStage,
+} from './initialization';
+
+const secret = 'Bearer private-token query=request prompt=secret 401';
+const detail: SubagentResolutionDiagnostic = {
+  phase: 'config',
+  subagentType: secret,
+  aborted: false,
+  type: 'Error',
+  cause: 'unknown',
+  message: 'Subagent error: Unable to initialize the selected subagent.',
+  parentRunId: '11111111-1111-4111-8111-111111111111',
+  childRunId: '22222222-2222-4222-8222-222222222222',
+  parentToolCallId: secret,
+};
+
+describe('subagent initialization diagnostics', () => {
+  it.each(['configuration_changed', 'agent_unavailable', 'model_unavailable'] as const)(
+    'classifies %s through a cause chain without disclosing text',
+    (code) => {
+      const log = jest.fn();
+      const handler = createSubagentResolutionFailureHandler(log);
+      const error = new Error(secret, { cause: new SubagentInitializationError(code) });
+      expect(handler(detail, error)).toBe(code);
+      expect(log.mock.calls[0][1]).toMatchObject({
+        cause: code,
+        parentRunId: detail.parentRunId,
+        childRunId: detail.childRunId,
+      });
+      expect(JSON.stringify(log.mock.calls)).not.toContain(secret);
+    },
+  );
+
+  it.each(['provider', 'tools', 'skills'] as const)(
+    'retains %s stage and unknown cause',
+    async (stage) => {
+      const error = Object.assign(new Error(secret), { name: secret, code: secret, status: 401 });
+      await expect(
+        withInitializationStage(stage, () => {
+          throw error;
+        }),
+      ).rejects.toBe(error);
+      const log = jest.fn();
+      expect(createSubagentResolutionFailureHandler(log)(detail, error)).toBe('unknown');
+      expect(log.mock.calls[0][1]).toMatchObject({
+        errors: [{ type: 'Error', stage, status: 401 }],
+      });
+      expect(JSON.stringify(log.mock.calls)).not.toContain(secret);
+    },
+  );
+
+  it('allowlists MCP codes without misclassifying them as agent permission failures', () => {
+    const log = jest.fn();
+    const handler = createSubagentResolutionFailureHandler(log);
+    expect(
+      handler(detail, Object.assign(new Error(secret), { code: 'MCP_AUTHENTICATION_REJECTED' })),
+    ).toBe('unknown');
+    expect(log.mock.calls[0][1]).toMatchObject({
+      errors: [{ code: 'MCP_AUTHENTICATION_REJECTED' }],
+    });
+  });
+
+  it('bounds circular/deep causes and survives hostile getters and prototype traps', () => {
+    const log = jest.fn();
+    const handler = createSubagentResolutionFailureHandler(log);
+    const hostile = new Proxy(
+      {},
+      {
+        get() {
+          throw new Error(secret);
+        },
+        getPrototypeOf() {
+          throw new Error(secret);
+        },
+      },
+    );
+    expect(handler(detail, hostile)).toBe('unknown');
+    const circular = { cause: {} };
+    circular.cause = circular;
+    expect(handler(detail, circular)).toBe('unknown');
+    let deep: Error = new SubagentInitializationError('model_unavailable');
+    for (let i = 0; i < 20; i++) deep = new Error(secret, { cause: deep });
+    expect(handler(detail, deep)).toBe('unknown');
+    expect(log.mock.calls[2][1].errors).toHaveLength(6);
+    expect(JSON.stringify(log.mock.calls)).not.toContain(secret);
+  });
+
+  it('keeps classification when the logger fails', () => {
+    const handler = createSubagentResolutionFailureHandler(() => {
+      throw new Error(secret);
+    });
+    expect(handler(detail, new SubagentInitializationError('configuration_changed'))).toBe(
+      'configuration_changed',
+    );
+  });
+
+  it('retains SDK host-argument refusals and recognizes a stable LangChain code', () => {
+    const log = jest.fn();
+    const handler = createSubagentResolutionFailureHandler(log);
+    expect(handler({ ...detail, cause: 'host_argument_rejected' }, new Error(secret))).toBe(
+      'host_argument_rejected',
+    );
+    expect(handler(detail, { code: secret, lc_error_code: 'MODEL_NOT_FOUND' })).toBe(
+      'model_unavailable',
+    );
+    expect(JSON.stringify(log.mock.calls)).not.toContain(secret);
+  });
+
+  it.each([new GraphInterrupt([]), new DOMException('Aborted', 'AbortError')])(
+    'preserves control-flow error identity',
+    async (error) => {
+      await expect(withInitializationStage('provider', () => Promise.reject(error))).rejects.toBe(
+        error,
+      );
+    },
+  );
+});
+
+describe('selected subagent preflight', () => {
+  function setup() {
+    return {
+      agent: { version: 'current' },
+      configId: 'current',
+      getConfigId: (agent: { version: string }) => agent.version,
+      canView: jest.fn().mockResolvedValue(true),
+      validateModel: jest.fn().mockResolvedValue({ isValid: true }),
+      signal: new AbortController().signal,
+    };
+  }
+
+  it.each(['configuration', 'permission', 'model'] as const)(
+    'rejects %s before child initialization',
+    async (stage) => {
+      const params = setup();
+      if (stage === 'configuration') params.configId = 'old';
+      if (stage === 'permission') params.canView.mockResolvedValue(false);
+      if (stage === 'model')
+        params.validateModel.mockResolvedValue({ isValid: false, error: { message: secret } });
+      const initialize = jest.fn();
+      const log = jest.fn();
+      const codes = {
+        configuration: 'configuration_changed',
+        permission: 'agent_unavailable',
+        model: 'model_unavailable',
+      };
+      await validateSelectedSubagent(params).then(initialize, (error) => {
+        expect(createSubagentResolutionFailureHandler(log)(detail, error)).toBe(codes[stage]);
+      });
+      expect(initialize).not.toHaveBeenCalled();
+      expect(log.mock.calls[0][1]).toMatchObject({ errors: [{ stage, code: codes[stage] }] });
+      expect(JSON.stringify(log.mock.calls)).not.toContain(secret);
+      if (stage !== 'model') expect(params.validateModel).not.toHaveBeenCalled();
+    },
+  );
+
+  it('reuses prior VIEW check and still validates the model', async () => {
+    const params = setup();
+    await validateSelectedSubagent({ ...params, viewAccessChecked: true });
+    expect(params.canView).not.toHaveBeenCalled();
+    expect(params.validateModel).toHaveBeenCalledTimes(1);
+  });
+
+  it('preserves owned cancellation without invoking the model validator', async () => {
+    const params = setup();
+    const controller = new AbortController();
+    const error = new Error(secret);
+    controller.abort(error);
+    await expect(validateSelectedSubagent({ ...params, signal: controller.signal })).rejects.toBe(
+      error,
+    );
+    expect(params.validateModel).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/api/src/agents/initialization.ts b/packages/api/src/agents/initialization.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a2a85bc3d8a2cc46a3a9aa65b1292f274820a13
--- /dev/null
+++ b/packages/api/src/agents/initialization.ts
@@ -0,0 +1,157 @@
+import { createHash } from 'crypto';
+import type { SubagentResolutionCause, SubagentResolutionFailureHandler } from '@librechat/agents';
+import { getSafeErrorMetadata } from '~/utils/errors';
+
+type InitializationStage =
+  | 'configuration'
+  | 'permission'
+  | 'model'
+  | 'provider'
+  | 'tools'
+  | 'skills';
+type SelectionFailure = 'configuration_changed' | 'agent_unavailable' | 'model_unavailable';
+
+/** Stage annotations preserve exception identity, including cancellation and graph interrupts. */
+const stages = new WeakMap<object, InitializationStage>();
+
+export class SubagentInitializationError extends Error {
+  constructor(public readonly code: SelectionFailure) {
+    super('Selected subagent initialization was rejected.');
+    this.name = 'SubagentInitializationError';
+  }
+}
+
+export async function withInitializationStage<T>(
+  stage: InitializationStage,
+  operation: () => T | Promise<T>,
+): Promise<T> {
+  try {
+    return await operation();
+  } catch (error) {
+    if (error != null && typeof error === 'object' && !stages.has(error)) {
+      stages.set(error, stage);
+    }
+    throw error;
+  }
+}
+
+/** Reuses the selected document and request's authorization/model checks without extra reads. */
+export async function validateSelectedSubagent<T>({
+  agent,
+  configId,
+  getConfigId,
+  canView,
+  validateModel,
+  signal,
+  viewAccessChecked = false,
+}: {
+  agent: T | null | undefined;
+  configId: string;
+  getConfigId: (agent: T) => string;
+  canView: () => Promise<boolean>;
+  validateModel: () => Promise<{ isValid: boolean }>;
+  signal: AbortSignal;
+  viewAccessChecked?: boolean;
+}): Promise<void> {
+  signal.throwIfAborted();
+  await withInitializationStage('configuration', () => {
+    if (agent == null || getConfigId(agent) !== configId) {
+      throw new SubagentInitializationError('configuration_changed');
+    }
+  });
+  await withInitializationStage('permission', async () => {
+    if (!viewAccessChecked && !(await canView())) {
+      throw new SubagentInitializationError('agent_unavailable');
+    }
+  });
+  signal.throwIfAborted();
+  await withInitializationStage('model', async () => {
+    const validation = await validateModel();
+    signal.throwIfAborted();
+    if (!validation.isValid) {
+      throw new SubagentInitializationError('model_unavailable');
+    }
+  });
+}
+
+const knownCodes = new Map<string, SubagentResolutionCause>([
+  ['configuration_changed', 'configuration_changed'],
+  ['agent_unavailable', 'agent_unavailable'],
+  ['model_unavailable', 'model_unavailable'],
+  ['AGENT_EXPECTED_MCP_TOOLS_UNAVAILABLE', 'unknown'],
+  ['MCP_AUTHENTICATION_REJECTED', 'unknown'],
+  ['MCP_AUTHENTICATION_REFRESH_FAILED', 'unknown'],
+  ['MCP_DOMAIN_NOT_ALLOWED', 'unknown'],
+  ['MCP_INSPECTION_FAILED', 'unknown'],
+  ['MODEL_NOT_FOUND', 'model_unavailable'],
+]);
+
+function property(value: object, key: string): unknown {
+  try {
+    return (value as Record<string, unknown>)[key];
+  } catch {
+    return undefined;
+  }
+}
+
+/** UUIDs stay searchable; other identifiers are hashed so names or hostile text cannot leak. */
+function correlation(value: string | undefined): string | undefined {
+  if (typeof value !== 'string' || value.length === 0 || value.length > 512) {
+    return undefined;
+  }
+  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)
+    ? value
+    : `sha256:${createHash('sha256').update(value).digest('hex')}`;
+}
+
+/** Only bounded, allowlisted metadata reaches the sink; classification never reads error text. */
+export function createSubagentResolutionFailureHandler(
+  log: (message: string, metadata: object) => void,
+): SubagentResolutionFailureHandler {
+  return (detail, error) => {
+    let cause: SubagentResolutionCause =
+      detail.cause === 'host_argument_rejected' ? 'host_argument_rejected' : 'unknown';
+    const chain: Array<
+      ReturnType<typeof getSafeErrorMetadata> & {
+        code?: string;
+        stage?: InitializationStage;
+      }
+    > = [];
+    const seen = new Set<object>();
+    let current = error;
+    for (let depth = 0; depth < 6 && current != null && typeof current === 'object'; depth++) {
+      if (seen.has(current)) break;
+      seen.add(current);
+      const code = [property(current, 'code'), property(current, 'lc_error_code')].find(
+        (value): value is string => typeof value === 'string' && knownCodes.has(value),
+      );
+      const stage = stages.get(current);
+      chain.push({
+        ...getSafeErrorMetadata(current),
+        ...(code && { code }),
+        ...(stage && { stage }),
+      });
+      if (cause === 'unknown' && code != null) cause = knownCodes.get(code) ?? 'unknown';
+      current = property(current, 'cause');
+    }
+    try {
+      log('[SubagentExecutor] Subagent initialization failed', {
+        phase: detail.phase === 'identity' ? 'identity' : 'config',
+        type: chain[0]?.type ?? 'UnknownError',
+        aborted: detail.aborted === true,
+        cause,
+        parentRunId: correlation(detail.parentRunId),
+        parentAgentId: correlation(detail.parentAgentId),
+        parentToolCallId: correlation(detail.parentToolCallId),
+        threadId: correlation(detail.threadId),
+        childRunId: correlation(detail.childRunId),
+        childThreadId: correlation(detail.childThreadId),
+        taskId: correlation(detail.taskId),
+        errors: chain,
+      });
+    } catch {
+      // Diagnostics must not replace the initialization failure or its safe classification.
+    }
+    return cause;
+  };
+}
