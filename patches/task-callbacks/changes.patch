+            payload: { receiptId: record.receiptId },
+          },
+          target: {
+            agentId: record.agentId,
+            conversationId: record.conversationId,
+            parentMessageId: record.messageId,
+          },
+          input: 'An external task has completed. Resolve its durable result.',
