diff --git a/packages/api/src/agents/handlers.ptcFiles.spec.ts b/packages/api/src/agents/handlers.ptcFiles.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..281512994cbdf077f8c1151f1ff6691d8b839cda
--- /dev/null
+++ b/packages/api/src/agents/handlers.ptcFiles.spec.ts
@@ -0,0 +1,380 @@
+import { z } from 'zod';
+import axios from 'axios';
+import { createServer } from 'node:http';
+import { Constants } from '@librechat/agents';
+import { tool } from '@librechat/agents/langchain/tools';
+import type { PTCToolCall, PTCToolResult, ToolExecuteResult } from '@librechat/agents';
+import type { StructuredToolInterface } from '@librechat/agents/langchain/tools';
+import type { PtcToolCallEvent, TFile } from 'librechat-data-provider';
+import type { FileStorageClaim } from '@librechat/data-schemas';
+import type { ProvisionToolContext, ProvisionCallbackDeps } from '~/files/provision/callback';
+import type { FileProvisionStorage } from '~/files/operations';
+import type { ToolExecuteOptions } from './handlers';
+import type { ServerRequest } from '~/types';
+import { createProvisionFilesCallback } from '~/files/provision/callback';
+import { createContextProgrammaticBashTool } from '~/code/command';
+import { createFileProvisionRecovery } from '~/files/operations';
+import { selectFileCitationSources } from '~/files/citations';
+import { createFileSearchTool } from '~/files/rag/search';
+import { createToolExecuteHandler } from './handlers';
+
+interface BridgeRequest {
+  tool_results?: PTCToolResult[];
+}
+interface QueryRequest {
+  file_id: string;
+  query: string;
+  entity_id?: string;
+}
+let respond: (path: string, request: BridgeRequest & QueryRequest) => object;
+let baseUrl: string;
+const server = createServer(async (req, res) => {
+  const chunks: Buffer[] = [];
+  for await (const chunk of req) chunks.push(Buffer.from(chunk));
+  res.setHeader('Content-Type', 'application/json');
+  res.end(JSON.stringify(respond(req.url ?? '', JSON.parse(Buffer.concat(chunks).toString()))));
+});
+beforeAll(async () => {
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const address = server.address();
+  if (!address || typeof address === 'string') throw new Error('Missing bridge address');
+  baseUrl = `http://127.0.0.1:${address.port}`;
+});
+afterAll(async () => {
+  server.closeAllConnections();
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+});
+
+const search = (id = 'search'): PTCToolCall => ({
+  id,
+  name: 'file_search',
+  input: { query: 'report' },
+});
+const mcp = { id: 'mcp', name: 'read_mcp_fixture', input: {} };
+
+function harness({
+  steps = [[search()]],
+  searchAllowed = true,
+  ragApiUrl = baseUrl as string | null,
+  runSignal,
+}: {
+  steps?: PTCToolCall[][];
+  searchAllowed?: boolean;
+  ragApiUrl?: string | null;
+  runSignal?: AbortSignal;
+} = {}) {
+  const files = ['user-file', 'agent-file'].map(
+    (file_id) =>
+      ({
+        file_id,
+        filename: `${file_id}.md`,
+        user: 'user',
+        embedded: false,
+      }) as TFile,
+  );
+  const context: ProvisionToolContext = {
+    provisionState: {
+      codeEnvFiles: [files[0]],
+      vectorDBFiles: files,
+      aliveFileIds: new Set(),
+      agentScopedFileIds: new Set(['agent-file']),
+    },
+  };
+  const claims = new Set<string>();
+  const claimKey = (claim: FileStorageClaim) =>
+    JSON.stringify([claim.tenantId ?? null, claim.userId, claim.file_id]);
+  const storage: FileProvisionStorage = {
+    recovery: createFileProvisionRecovery(),
+    acquireFileProvision: async (claim) => {
+      const key = claimKey(claim);
+      if (claims.has(key)) return false;
+      claims.add(key);
+      return true;
+    },
+    releaseFileProvision: async (claim) => claims.delete(claimKey(claim)),
+    commitFileProvision: async ({ claim }) => claims.has(claimKey(claim)),
+  };
+  const vector = jest.fn<
+    ReturnType<ProvisionCallbackDeps['provisionToVectorDB']>,
+    Parameters<ProvisionCallbackDeps['provisionToVectorDB']>
+  >(async ({ file }) => ({
+    embedded: true,
+    fileUpdate: { file_id: file.file_id, embedded: true },
+  }));
+  const codeUpload = jest.fn<
+    ReturnType<ProvisionCallbackDeps['provisionToCodeEnv']>,
+    Parameters<ProvisionCallbackDeps['provisionToCodeEnv']>
+  >(async ({ file }) => ({
+    referenceSet: {
+      codeEnvRefs: {
+        default: {
+          kind: 'user',
+          id: 'user',
+          storage_session_id: 'session',
+          file_id: 'remote-file',
+        },
+      },
+    },
+    refUpdate: {
+      file_id: file.file_id,
+      routeKey: 'default',
+      ref: {
+        kind: 'user',
+        id: 'user',
+        storage_session_id: 'session',
+        file_id: 'remote-file',
+      },
+    },
+    sandboxFilename: file.filename,
+  }));
+  const provisionFiles = createProvisionFilesCallback({
+    req: { user: { id: 'user' } } as ServerRequest,
+    ragApiUrl: ragApiUrl ?? undefined,
+    agentToolContexts: new Map([['agent', context]]),
+    fileStorage: storage,
+    provisionToCodeEnv: codeUpload,
+    provisionToVectorDB: vector,
+    updateFile: async () => true,
+    updateCodeEnvRef: async () => true,
+    addEmbeddedEntity: async () => true,
+  });
+  const mcpInvoke = jest.fn(async () => 'MCP ready');
+  const mcpTool = tool(mcpInvoke, {
+    name: mcp.name,
+    description: 'Local MCP fixture.',
+    schema: z.object({}),
+  });
+  const batches: PTCToolResult[][] = [];
+  const queries: QueryRequest[] = [];
+  const queryReadiness: boolean[] = [];
+  let step = 0;
+  respond = (path, request) => {
+    if (path === '/query') {
+      queries.push(request);
+      queryReadiness.push(
+        files.find((file) => file.file_id === request.file_id)?.embedded === true,
+      );
+      return [[{ page_content: 'report content', metadata: { source: '/report.md' } }, 0.1]];
+    }
+    if (request.tool_results) batches.push(request.tool_results);
+    const calls = steps[step++];
+    return calls
+      ? {
+          status: 'tool_call_required',
+          continuation_token: 'local-fixture',
+          tool_calls: calls,
+        }
+      : { status: 'completed', stdout: 'done', stderr: '', files: [] };
+  };
+  const events: PtcToolCallEvent[] = [];
+  const loadTools: jest.MockedFunction<ToolExecuteOptions['loadTools']> = jest.fn(async (names) => {
+    // A fresh snapshot reproduces the production factory's captured file list.
+    const resource = context.tool_resources?.file_search;
+    const searchTool = await createFileSearchTool({
+      ragApiUrl: ragApiUrl ?? undefined,
+      userId: 'user',
+      entity_id: 'agent',
+      files: [
+        ...(resource?.files ?? []).map((file) => ({ file_id: file.file_id })),
+        ...(resource?.file_ids ?? []).map((file_id) => ({ file_id, fromAgent: true })),
+      ],
+      httpClient: axios,
+      generateShortLivedToken: () => 'fixture',
+      logAxiosError: () => '',
+      selectFileCitationSources,
+      logger: { debug: jest.fn() },
+    });
+    if (names.includes('file_search')) return { loadedTools: searchTool ? [searchTool] : [] };
+    const ptc = createContextProgrammaticBashTool(() => ({}), {
+      baseUrl,
+      codeSessionKey: 'fixture',
+      executionProfile: 'default',
+      statefulSessions: false,
+    });
+    ptc.name = names[0];
+    const ptcToolMap = new Map<string, StructuredToolInterface>([[mcpTool.name, mcpTool]]);
+    if (searchTool) ptcToolMap.set(searchTool.name, searchTool);
+    return {
+      loadedTools: [ptc],
+      configurable: {
+        ptcToolMap,
+        toolRegistry: new Map(
+          [...ptcToolMap.keys()].map((name) => [
+            name,
+            {
+              name,
+              description: name,
+              parameters:
+                name === 'file_search'
+                  ? {
+                      type: 'object',
+                      properties: {
+                        query: { type: 'string' },
+                      },
+                      required: ['query'],
+                    }
+                  : { type: 'object', properties: {} },
+              allowed_callers:
+                name === 'file_search' && !searchAllowed
+                  ? ['direct']
+                  : ['direct', 'code_execution'],
+            },
+          ]),
+        ),
+      },
+    };
+  });
+  const handler = createToolExecuteHandler({
+    loadTools,
+    provisionFiles,
+    runSignal,
+    emitPtcProgress: (event) => events.push(event),
+  });
+  const run = (
+    name = Constants.BASH_PROGRAMMATIC_TOOL_CALLING,
+    args: Record<string, unknown> | string = { code: 'dynamic_call "{}"' },
+  ) =>
+    new Promise<ToolExecuteResult[]>((resolve, reject) => {
+      handler.handle('on_tool_execute', {
+        agentId: 'agent',
+        // The handler also accepts provider JSON strings beyond the SDK event type.
+        toolCalls: [{ id: 'outer', name, args: args as Record<string, unknown> }],
+        resolve,
+        reject,
+      });
+    });
+  return {
+    run,
+    vector,
+    codeUpload,
+    loadTools,
+    context,
+    batches,
+    queries,
+    queryReadiness,
+    mcpInvoke,
+    events,
+  };
+}
+
+it.each([
+  [Constants.BASH_PROGRAMMATIC_TOOL_CALLING, false],
+  [Constants.PROGRAMMATIC_TOOL_CALLING, true],
+])(
+  'prepares an actual inner search without a manifest (%s, JSON string %s)',
+  async (name, json) => {
+    const h = harness();
+    const input = { code: 'dynamic_call "{}"' };
+    const [result] = await h.run(name, json ? JSON.stringify(input) : input);
+    expect(result.status).toBe('success');
+    expect(h.vector).toHaveBeenCalledTimes(2);
+    expect(h.codeUpload).toHaveBeenCalledTimes(1);
+    expect(h.queries).toEqual(
+      expect.arrayContaining([
+        { file_id: 'user-file', query: 'report', k: 5 },
+        { file_id: 'agent-file', entity_id: 'agent', query: 'report', k: 5 },
+      ]),
+    );
+    expect(h.queryReadiness).toEqual([true, true]);
+    expect(JSON.stringify(h.batches)).toContain('report content');
+    expect(h.loadTools.mock.calls.map(([names]) => names)).toEqual([[name], ['file_search']]);
+  },
+);
+
+it.each([null, '', ' \t\n', 'configured'])(
+  'keeps pure MCP PTC free of search preparation (%j)',
+  async (url) => {
+    const h = harness({ steps: [[mcp]], ragApiUrl: url === 'configured' ? baseUrl : url });
+    const [result] = await h.run(undefined, {
+      code: '# file_search is only a comment\nread_mcp_fixture "{}"',
+      tool_manifest: url === 'configured' ? [mcp.name, 'file_search'] : [mcp.name],
+    });
