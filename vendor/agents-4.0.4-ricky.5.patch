+      ],
+      expected: [{ type: 'text', text: 'Body' }],
+      expectedDeltaCount: 1,
+    },
+    {
+      name: '普通文本顺序',
+      chunks: [
+        new AIMessageChunk({ content: 'First ' }),
+        new AIMessageChunk({ content: 'second' }),
