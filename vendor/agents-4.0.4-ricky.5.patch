+            { type: 'text', text: 'First ' },
+            { type: 'text', text: 'second' },
+          ],
+          additional_kwargs: { reasoning: { type: 'reasoning', summary: [] } },
+        }),
+      ],
+      expected: [
+        { type: 'thinking', thinking: 'Thinking' },
+        { type: 'text', text: 'First ' },
+        { type: 'text', text: 'second' },
+      ],
+      expectedDeltaCount: 1,
+    },
