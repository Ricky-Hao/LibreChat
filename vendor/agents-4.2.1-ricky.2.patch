+import { Constants } from '@/common';
+
+describe('execution-schema intent normalization', () => {
+  const schema = z.object({ id: z.string(), expanded: z.boolean() }).strict();
+  const args = Object.freeze({
+    id: 'agent',
+    expanded: false,
+    intent: 'Inspecting agent',
