@@ -0,0 +1,99 @@
+import fetch from 'node-fetch';
+import { z } from 'zod';
+import { tool } from '@langchain/core/tools';
+import { ToolMessage } from '@langchain/core/messages';
+import type { RequestInit } from 'node-fetch';
+import type { PTCToolResult } from '@/types';
+import { createProgrammaticToolCallingTool } from '../ProgrammaticToolCalling';
+import { createBashProgrammaticToolCallingTool } from '../BashProgrammaticToolCalling';
+
+jest.mock('node-fetch', () => ({ __esModule: true, default: jest.fn() }));
+const fetchMock = jest.mocked(fetch);
+
+describe('real host runners with fixture CodeAPI continuation responses', () => {
+  it.each([
+    [
+      'Python',
+      createProgrammaticToolCallingTool,
+      'await missing(); print(await valid())',
+    ],
+    ['Bash', createBashProgrammaticToolCallingTool, 'missing "{}"; valid "{}"'],
+  ] as const)(
+    '%s submits error status, then preserves a later successful result',
+    async (_language, create, code) => {
+      const bodies: Array<{ tool_results?: PTCToolResult[] }> = [];
+      fetchMock.mockReset();
+      fetchMock.mockImplementation(async (_url, init) => {
+        bodies.push(JSON.parse((init as RequestInit).body as string));
+        const response = [
+          {
+            status: 'tool_call_required',
+            continuation_token: 'first',
+            tool_calls: [{ id: 'bad', name: 'missing', input: {} }],
+          },
+          {
+            status: 'tool_call_required',
+            continuation_token: 'second',
+            tool_calls: [{ id: 'good', name: 'valid', input: {} }],
+          },
+          {
+            status: 'completed',
+            session_id: 'fixture',
+            stdout: 'handled; valid',
+            files: [],
+          },
+        ][bodies.length - 1];
+        return { ok: true, json: async () => response } as Awaited<
+          ReturnType<typeof fetch>
+        >;
+      });
+      const failed = new ToolMessage({
+        content: 'Missing fixture file',
+        status: 'error',
+        tool_call_id: '',
+      });
+      const missing = tool(async () => failed, {
+        name: 'missing',
+        description: 'fixture',
+        schema: z.object({}),
+      });
+      const valid = tool(async () => ({ sha: 'fixture-sha' }), {
+        name: 'valid',
+        description: 'fixture',
+        schema: z.object({}),
+      });
+      const tools = [missing, valid];
+      const runner = create({
+        baseUrl: 'https://code.fixture.invalid',
+        authHeaders: {},
+      });
+      const output = await runner.invoke(
+        { code, tool_manifest: ['missing', 'valid'] },
+        {
+          toolCall: {
+            name: runner.name,
+            args: {},
+            toolMap: new Map(tools.map((value) => [value.name, value])),
+            toolDefs: tools.map((value) => ({
+              name: value.name,
+              description: 'fixture',
+              parameters: { type: 'object' },
+            })),
+          },
+        }
+      );
+      expect(bodies).toHaveLength(3);
+      expect(bodies[1].tool_results).toMatchObject([
+        {
+          call_id: 'bad',
+          is_error: true,
+          error_message: 'Tool reported an error.',
+        },
+      ]);
+      expect(bodies[2].tool_results).toEqual([
+        { call_id: 'good', is_error: false, result: { sha: 'fixture-sha' } },
+      ]);
+      expect(JSON.stringify(output)).toContain('handled; valid');
+    }
+  );
+});
diff --git a/src/tools/__tests__/programmaticLocalResults.test.ts b/src/tools/__tests__/programmaticLocalResults.test.ts
new file mode 100644
index 00000000..cd2aa392
--- /dev/null
+++ b/src/tools/__tests__/programmaticLocalResults.test.ts
@@ -0,0 +1,80 @@
+import { z } from 'zod';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tool } from '@langchain/core/tools';
+import { ToolMessage } from '@langchain/core/messages';
+import {
+  createLocalProgrammaticToolCallingTool,
+  createLocalBashProgrammaticToolCallingTool,
+} from '../local/LocalProgrammaticToolCalling';
+
+describe('actual local wrappers (not the remote CodeAPI backend)', () => {
+  it.each([
+    [
+      'py',
+      createLocalProgrammaticToolCallingTool,
+      'try:\n  await missing()\nexcept RuntimeError:\n  print("caught")\nprint((await valid())["sha"])',
+    ],
+    [
+      'bash',
+      createLocalBashProgrammaticToolCallingTool,
+      'if missing "{}"; then echo unexpected; else echo caught; fi\nvalid "{}"',
+    ],
+  ] as const)(
+    '%s exposes an actionable failure and permits later success',
+    async (lang, create, code) => {
+      const cwd = await mkdtemp(join(tmpdir(), 'ptc-result-'));
+      try {
+        const missing = tool(
+          async () =>
+            new ToolMessage({
+              content: 'Missing fixture file',
+              status: 'error',
+              tool_call_id: '',
+            }),
+          { name: 'missing', description: 'fixture', schema: z.object({}) }
+        );
+        const valid = tool(async () => ({ sha: 'fixture-sha' }), {
+          name: 'valid',
+          description: 'fixture',
+          schema: z.object({}),
+        });
+        const tools = [missing, valid];
+        const runner = create({ cwd, timeoutMs: 10000 });
+        const config = {
+          toolCall: {
+            name: runner.name,
+            args: {},
+            toolMap: new Map(tools.map((value) => [value.name, value])),
+            toolDefs: tools.map((value) => ({
+              name: value.name,
+              description: 'fixture',
+              parameters: { type: 'object' },
+            })),
+          },
+        };
+        const output = await runner.invoke(
+          { code, lang, tool_manifest: ['missing', 'valid'] },
+          config
+        );
+        expect(JSON.stringify(output)).toContain('caught');
+        expect(JSON.stringify(output)).toContain('fixture-sha');
+        expect(JSON.stringify(output)).not.toContain('unexpected');
+        await expect(
+          runner.invoke(
+            {
+              code: lang === 'py' ? 'await missing()' : 'missing "{}"',
+              lang,
+              tool_manifest: ['missing'],
+            },
+            config
+          )
+        ).rejects.toThrow('Tool reported an error.');
+      } finally {
+        await rm(cwd, { recursive: true, force: true });
+      }
+    },
+    30000
+  );
+});
diff --git a/src/tools/__tests__/programmaticResults.test.ts b/src/tools/__tests__/programmaticResults.test.ts
