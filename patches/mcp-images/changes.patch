new file mode 100644
index 0000000000000000000000000000000000000000..21a54ffd78ed106bc3a2966b0704e4fdb41fcb70
--- /dev/null
+++ b/packages/api/src/utils/imageDiagnostics.ts
@@ -0,0 +1,184 @@
+import sharp from 'sharp';
+import { createHash } from 'node:crypto';
+import { logger, redactMessage } from '@librechat/data-schemas';
+import { resolveImageMimeType, sniffImageMimeType } from '~/files/mime';
+
+const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
+const MAX_BASE64_LENGTH = Math.ceil(MAX_IMAGE_BYTES / 3) * 4;
+const MAX_IMAGE_PIXELS = 4096 * 4096;
+const MAX_IMAGES_PER_BOUNDARY = 4;
+const HTTP_URL_PREFIX = /^https?:\/\//i;
+const BASE64_DATA_URL_PREFIX = /^data:([a-z0-9][a-z0-9.+/-]{0,63});base64,/i;
+const LOGGABLE_IMAGE_MIME =
+  /^image\/(png|jpeg|jpg|gif|webp|avif|heic|heif|tiff|bmp|svg\+xml|jp2|jxl)$/i;
+
+type ImageLogMetadata = Record<string, string | number | undefined>;
+type ImageReference = { image_url?: string | null; file_id?: string | null };
+type ImageInput = { data: string; mimeType: string } | ImageReference;
+export type ImageLogEntry = { image: ImageInput; location: ImageLogMetadata };
+
+type ImageDiagnostic = {
+  source: 'inline' | 'url' | 'file' | 'unknown';
+  status:
+    | 'decoded'
+    | 'pixel_decode_failed'
+    | 'header_unreadable'
+    | 'unknown_format'
+    | 'malformed_base64'
+    | 'malformed_data_url'
+    | 'missing_source'
+    | 'unknown_source'
+    | 'external'
+    | 'byte_limit'
+    | 'pixel_limit'
+    | 'multiple_frames'
+    | 'diagnostic_error';
+  declared_mime?: string;
+  detected_mime?: string;
+  encoded_bytes?: number;
+  header_readable?: boolean;
+  width?: number;
+  height?: number;
+  sha256?: string;
+};
+
+export function imageLogIdentifier(value: string | undefined): string | undefined {
+  if (value && /^[a-z0-9_.-]{1,128}$/i.test(value) && redactMessage(value) === value) {
+    return value;
+  }
+}
+
+export function keepRecentImage(entries: ImageLogEntry[], entry: ImageLogEntry): void {
+  if (entries.length === MAX_IMAGES_PER_BOUNDARY) {
+    entries.shift();
+  }
+  entries.push(entry);
+}
+
+function declaredMime(mimeType: string): string | undefined {
+  if (mimeType) {
+    return LOGGABLE_IMAGE_MIME.test(mimeType) ? mimeType.toLowerCase() : 'unknown';
+  }
+}
+
+async function inspectRaster(bytes: Buffer, fields: ImageDiagnostic): Promise<ImageDiagnostic> {
+  const detectedMime = sniffImageMimeType(bytes);
+  if (!detectedMime) {
+    return fields;
+  }
+
+  // Sharp reads headers independently of the pixel limit on its decode pipeline.
+  const image = sharp(bytes, { failOn: 'warning', limitInputPixels: MAX_IMAGE_PIXELS });
+  const metadata = await image.metadata().catch(() => undefined);
+  if (!metadata?.width || !metadata.height) {
+    return {
+      ...fields,
+      detected_mime: detectedMime,
+      status: 'header_unreadable',
+      header_readable: false,
+    };
+  }
+  const { width, height, pages } = metadata;
+  const header = {
+    ...fields,
+    width,
+    height,
+    header_readable: true,
+    detected_mime: resolveImageMimeType(metadata) ?? detectedMime,
+    sha256: createHash('sha256').update(bytes).digest('hex'),
+  };
+  if (width * height > MAX_IMAGE_PIXELS) {
+    return { ...header, status: 'pixel_limit' };
+  }
+  if (pages != null && pages > 1) {
+    return { ...header, status: 'multiple_frames' };
+  }
+
+  try {
+    await image.timeout({ seconds: 1 }).raw().toBuffer();
+    return { ...header, status: 'decoded' };
+  } catch {
+    return { ...header, status: 'pixel_decode_failed' };
+  }
+}
+
+async function inspectInlineImage(data: string, mimeType: string): Promise<ImageDiagnostic> {
+  const fields = { source: 'inline' as const, declared_mime: declaredMime(mimeType) };
+  if (data.length > MAX_BASE64_LENGTH) {
+    return { ...fields, status: 'byte_limit' };
+  }
+  const bytes = Buffer.from(data, 'base64');
+  // Buffer.from accepts invalid characters and padding. A round trip avoids hashing partial bytes.
+  const canonical = bytes.toString('base64');
+  if (bytes.length === 0 || (data !== canonical && data !== canonical.replace(/=+$/, ''))) {
+    return { ...fields, status: 'malformed_base64' };
+  }
+  if (bytes.length > MAX_IMAGE_BYTES) {
+    return { ...fields, status: 'byte_limit' };
+  }
+  return inspectRaster(bytes, { ...fields, status: 'unknown_format', encoded_bytes: bytes.length });
+}
+
+function inspectImage(image: ImageInput): ImageDiagnostic | Promise<ImageDiagnostic> {
+  if ('data' in image) {
+    if (HTTP_URL_PREFIX.test(image.data)) {
+      return { source: 'url', status: 'external', declared_mime: declaredMime(image.mimeType) };
+    }
+    return inspectInlineImage(image.data, image.mimeType);
+  }
+
+  const { image_url: url, file_id: fileId } = image;
+  if (url && fileId) {
+    return { source: 'unknown', status: 'unknown_source' };
+  }
+  if (!url) {
+    return fileId
+      ? { source: 'file', status: 'external' }
+      : { source: 'unknown', status: 'missing_source' };
+  }
+  const prefix = BASE64_DATA_URL_PREFIX.exec(url);
+  if (prefix) {
+    return inspectInlineImage(url.slice(prefix[0].length), prefix[1]);
+  }
+  if (HTTP_URL_PREFIX.test(url)) {
+    return { source: 'url', status: 'external' };
+  }
+  if (/^data:/i.test(url)) {
+    return { source: 'inline', status: 'malformed_data_url' };
+  }
+  return { source: 'unknown', status: 'unknown_source' };
+}
+
+async function writeImageDiagnostic(
+  message: string,
+  entry: ImageLogEntry,
+  context: ImageLogMetadata,
+): Promise<void> {
+  let diagnostic: ImageDiagnostic;
+  try {
+    diagnostic = await inspectImage(entry.image);
+  } catch {
+    diagnostic = { source: 'unknown', status: 'diagnostic_error' };
+  }
+  try {
+    logger.info(message, { ...context, ...entry.location, ...diagnostic });
+  } catch {
+    // Logging is best effort even if the transport fails.
+  }
+}
+
+export function scheduleImageDiagnostics(
+  message: string,
+  entries: ImageLogEntry[],
+  context: ImageLogMetadata,
+): void {
+  if (entries.length === 0) {
+    return;
+  }
+  // Neither tool formatting nor the SDK send waits on decoding. Inspect one raster at a time.
+  setImmediate(async () => {
+    for (const entry of entries) {
+      await writeImageDiagnostic(message, entry, context);
+    }
+  });
+}
