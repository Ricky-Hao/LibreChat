+      ['cross-fetch/dist/browser-ponyfill.js', 'http-client'],
+      ['sky-package/index.js', 'vendor'],
+    ]) {
+      const id = `${checkout}/node_modules/${module}`;
+      assert.equal(chunkName(id), expected, id);
+      assert.equal(chunkName(id.replaceAll('/', '\\')), expected, id);
+    }
+  }
