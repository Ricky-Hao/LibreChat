+    fileCitations: false,
+    httpClient: axios,
+    generateShortLivedToken: jest.fn(() => 'local-fixture-token'),
+    logAxiosError: jest.fn(),
+    selectFileCitationSources,
+    logger: { debug: jest.fn() },
+  };
+}
+
+it.each([undefined, '', ' \t\n'])(
+  'neither exposes a search tool nor executes a query without RAG (%j)',
+  async (ragApiUrl) => {
+    const deps = options(ragApiUrl);
+    expect(await createFileSearchTool(deps)).toBeUndefined();
+    await expect(executeFileSearchQuery({ ...deps, query: 'report' })).rejects.toThrow(
+      'File search is unavailable because RAG_API_URL is not configured.',
+    );
+    expect(deps.generateShortLivedToken).not.toHaveBeenCalled();
+  },
+);
+
+it('reports an unreachable configured RAG service as failure', async () => {
+  const server = createServer();
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const address = server.address();
+  if (!address || typeof address === 'string') throw new Error('Missing fixture address');
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+  const deps = options(`http://127.0.0.1:${address.port}`);
+  await expect(executeFileSearchQuery({ ...deps, query: 'report' })).rejects.toThrow(
+    'File search failed while querying the RAG service.',
+  );
+  expect(deps.logAxiosError).toHaveBeenCalledTimes(1);
+});
+
+it.each([undefined, '', ' \t\n'])(
+  'omits file context and storage reads without RAG (%j)',
+  async (ragApiUrl) => {
+    const getFiles = jest.fn();
+    const filterFilesByAgentAccess = jest.fn();
+    expect(
+      await primeFileSearchFiles({
+        ragApiUrl,
+        getFiles,
+        filterFilesByAgentAccess,
+        tool_resources: { file_search: { file_ids: ['agent-file'] } },
+      }),
+    ).toEqual({ files: [], toolContext: '' });
+    expect(getFiles).not.toHaveBeenCalled();
+    expect(filterFilesByAgentAccess).not.toHaveBeenCalled();
+  },
+);
+
+it('preserves access filtering and agent versus user search namespaces in file context', async () => {
+  const allowed = { file_id: 'allowed', filename: 'allowed.md' } as TFile;
+  const denied = { file_id: 'denied', filename: 'denied.md' } as TFile;
+  const attached = { file_id: 'attached', filename: 'attached.md' } as TFile;
+  const getFiles = jest.fn(async () => [allowed, denied]);
+  const filterFilesByAgentAccess = jest.fn(async () => [allowed]);
+  const result = await primeFileSearchFiles({
+    ragApiUrl: 'http://rag.test',
+    getFiles,
+    filterFilesByAgentAccess,
+    req: { user: { id: 'user', role: 'USER' } },
+    agentId: 'agent',
+    tool_resources: { file_search: { file_ids: ['allowed', 'denied'], files: [attached] } },
+  });
+  expect(filterFilesByAgentAccess).toHaveBeenCalledWith({
+    files: [allowed, denied],
+    userId: 'user',
+    role: 'USER',
+    agentId: 'agent',
+    resourceType: undefined,
+  });
+  expect(result.files).toEqual([
+    { file_id: 'allowed', filename: 'allowed.md', fromAgent: true },
+    { file_id: 'attached', filename: 'attached.md', fromAgent: false },
+  ]);
+  expect(result.toolContext).toContain('attached.md (just attached by user)');
+  expect(result.toolContext).not.toContain('denied.md');
+});
+
+it('forwards tool cancellation to an in-flight RAG HTTP query', async () => {
+  const server = createServer((_req, _res) => controller.abort());
+  const controller = new AbortController();
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  try {
+    const address = server.address();
+    if (!address || typeof address === 'string') throw new Error('Missing fixture address');
+    const searchTool = await createFileSearchTool(options(`http://127.0.0.1:${address.port}`));
+    expect(searchTool).toBeDefined();
+    await expect(
+      searchTool?.invoke({ query: 'report' }, { signal: controller.signal }),
+    ).rejects.toThrow(/aborted/i);
+    expect(controller.signal.aborted).toBe(true);
+  } finally {
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
