+          model: responsesModel,
+          model_parameters: { useResponsesApi: true },
+          tools: [toolKey, textTool, askTool],
+        }),
+      },
+    });
+    client.conversationId = conversationId;
+    client.responseMessageId = randomUUID();
+    let ref;
+    let sourceAttachments;
+    function serve(_req, response, sequence) {
+      if (sequence === 3) {
+        ref = imageRefOf(requests[sequence - 1].body);
+        sourceAttachments = saveBase64Image.mock.calls.length;
+      }
+      const name = [toolKey, textTool, 'read_image', textTool][sequence - 1];
+      const call =
+        name == null
+          ? undefined
+          : {
+              name,
+              call_id: callIds[sequence - 1],
+              arguments: JSON.stringify(sequence === 3 ? { ref } : {}),
+            };
+      writeResponsesStream(response, responsesModel, false, call, sequence);
+    }
+    requestLimit = 5;
+    respondToResponses = serve;
+    await tenantStorage.run({ requestId: randomUUID() }, () =>
+      client.chatCompletion({
+        userMCPAuthMap,
+        payload: [
+          {
+            messageId: randomUUID(),
+            isCreatedByUser: true,
+            content: [{ type: 'text', text: prompt }],
+          },
+        ],
+      }),
+    );
+
+    expect(unexpectedRequests).toBe(0);
+    const bodies = requests.map(({ body }) => body);
+    expect(bodies).toHaveLength(5);
+    expect(createRun.mock.calls[0][0].graphConfig.compileOptions?.checkpointer).toBeInstanceOf(
+      LazyMongoSaver,
+    );
+    for (const body of bodies) {
+      expect(body.tools.map(({ name }) => name)).toEqual(
+        expect.arrayContaining([askTool, 'read_image']),
+      );
+    }
+    expect(bodies[0].tools.find(({ name }) => name === 'read_image')?.parameters).toMatchObject({
+      type: 'object',
+      required: ['ref'],
+      additionalProperties: false,
+    });
+    expect(JSON.stringify(bodies[0].input).includes(prompt)).toBe(true);
+    expect(typeof ref).toBe('string');
+    const images = bodies.map(imageParts);
+    expect(images.map((parts) => parts.length)).toEqual([0, 1, 0, 1, 0]);
+    for (const index of [1, 3]) {
+      expect(images[index][0].image_url === `data:image/png;base64,${png}`).toBe(true);
+    }
+    expect(String(outputOf(bodies[1], callId)).includes(`[${ref}] (tool image 1)`)).toBe(true);
