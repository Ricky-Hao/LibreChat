diff --git a/packages/api/src/messages/history.spec.ts b/packages/api/src/messages/history.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3139cb13d15bc1eb16087a739c57beb31252d76
--- /dev/null
+++ b/packages/api/src/messages/history.spec.ts
@@ -0,0 +1,126 @@
+import express from 'express';
+import request from 'supertest';
+import type { MessageRequestValidation } from '~/middleware/messageValidation';
+import { createHistoryHandler, createAttachmentBodyHandler } from './history';
+
+const messages = [
+  {
+    messageId: 'reply',
+    conversationId: 'conversation',
+    text: 'Synthetic reply',
+    attachments: [{ filename: 'sample.txt' }],
+  },
+];
+const page = { messages, start: null, nextCursor: null };
+const getDisplayMessages = jest.fn().mockResolvedValue(page);
+const getHistoryAttachment = jest.fn().mockResolvedValue({ text: 'Synthetic body' });
+let validation: MessageRequestValidation;
+const deps = {
+  getDisplayMessages,
+  getHistoryAttachment,
+  validate: () => validation,
+  previews: () => async (input: typeof messages) => input,
+  sendValidationResponse: (res: express.Response, result: { status: number; body: unknown }) =>
+    res.status(result.status).json(result.body),
+  logError: jest.fn(),
+};
+function app() {
+  const server = express();
+  server.use((req, _res, next) => {
+    Object.assign(req, { user: { id: 'owner', tenantId: 'tenant' } });
+    next();
+  });
+  server.get(
+    '/:conversationId/history',
+    createHistoryHandler(deps as Parameters<typeof createHistoryHandler>[0], true),
+  );
+  server.get(
+    '/:conversationId',
+    createHistoryHandler(deps as Parameters<typeof createHistoryHandler>[0]),
+  );
+  server.get('/:conversationId/:messageId/attachments/:index', createAttachmentBodyHandler(deps));
+  return server;
+}
+beforeEach(() => {
+  jest.clearAllMocks();
+  validation = { shouldFetchMessages: true, promise: Promise.resolve({ ok: true }) };
+});
+
+test('keeps old full clients compatible while new history responses expose body references', async () => {
+  const full = await request(app()).get('/conversation').expect(200);
+  expect(full.body).toEqual(messages);
+  expect(getDisplayMessages).toHaveBeenLastCalledWith(
+    expect.objectContaining({ lazyAttachments: false, user: 'owner', tenantId: 'tenant' }),
+  );
+  const recent = await request(app()).get('/conversation/history?limit=12').expect(200);
+  expect(recent.body.messages[0].attachments[0].bodyRef).toMatchObject({
+    conversationId: 'conversation',
+    messageId: 'reply',
+    index: 0,
+  });
+  expect(getDisplayMessages).toHaveBeenLastCalledWith(
+    expect.objectContaining({ lazyAttachments: true, page: { limit: 12 } }),
+  );
+});
+
+test.each([
+  'limit=0',
+  'limit=101',
+  'before=bad',
+  'before=%7B%7D',
+  'before=%7B%22createdAt%22%3A%22bad%22%7D',
+])('rejects malformed paging (%s)', async (query) => {
+  await request(app()).get(`/conversation/history?${query}`).expect(400);
+  expect(getDisplayMessages).not.toHaveBeenCalled();
+});
+
+test('never sends scoped records until authorization succeeds, including active-job reads', async () => {
+  let allow!: (value: Awaited<MessageRequestValidation['promise']>) => void;
+  validation.promise = new Promise((resolve) => {
+    allow = resolve;
+  });
+  const response = request(app()).get('/conversation/history');
+  const pending = response.then((result) => result);
+  await new Promise((resolve) => setImmediate(resolve));
+  allow({ ok: false, status: 404, body: { error: 'Conversation not found' } });
+  const result = await pending;
+  expect(result.status).toBe(404);
+  expect(JSON.stringify(result.body)).not.toContain('Synthetic');
+});
+
+test('gates body reads, handles absence, and never exposes operational errors', async () => {
+  validation.promise = Promise.resolve({ ok: false, status: 403, body: { error: 'Forbidden' } });
+  await request(app()).get('/conversation/reply/attachments/0').expect(403);
+  expect(getHistoryAttachment).toHaveBeenCalledWith(
+    expect.objectContaining({
+      user: 'owner',
+      tenantId: 'tenant',
+      conversationId: 'conversation',
+      messageId: 'reply',
+      index: 0,
+    }),
+  );
+  validation.promise = Promise.resolve({ ok: true });
+  await request(app()).get('/conversation/reply/attachments/-1').expect(400);
+  getHistoryAttachment.mockResolvedValueOnce(null);
+  await request(app()).get('/conversation/reply/attachments/0').expect(404);
+  getHistoryAttachment.mockRejectedValueOnce(new Error('sensitive database diagnostic'));
+  const failed = await request(app()).get('/conversation/reply/attachments/0').expect(500);
+  expect(failed.body).toEqual({ error: 'Internal server error' });
+});
+
+test('a scoped read failure cannot respond ahead of a pending denial', async () => {
+  let finish!: (result: Awaited<MessageRequestValidation['promise']>) => void;
+  validation.promise = new Promise((resolve) => {
+    finish = resolve;
+  });
+  getDisplayMessages.mockRejectedValueOnce(new Error('private database error'));
+  const pending = request(app())
+    .get('/conversation/history')
+    .then((response) => response);
+  await new Promise((resolve) => setImmediate(resolve));
+  finish({ ok: false, status: 403, body: { error: 'Forbidden' } });
+  const response = await pending;
+  expect(response.status).toBe(403);
+  expect(response.body).toEqual({ error: 'Forbidden' });
+});
diff --git a/packages/api/src/messages/history.ts b/packages/api/src/messages/history.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91dc8d44ae09c6be9ffce37657c12903a2e40691
--- /dev/null
+++ b/packages/api/src/messages/history.ts
@@ -0,0 +1,174 @@
+import { z } from 'zod';
+import { MAX_HISTORY_PAGE_SIZE, DEFAULT_HISTORY_WINDOW_SIZE, Tools } from 'librechat-data-provider';
+import type { HistoryOptions, TMessage } from 'librechat-data-provider';
+import type { HistoryMethods } from '@librechat/data-schemas';
+import type { Request, Response } from 'express';
+import type {
+  MessageRequestValidation,
+  FailedMessageValidationResult,
+} from '~/middleware/messageValidation';
+import type { prepareToolCallPreviews } from './previews';
+
+type HistoryRequest = Request & { user?: { id?: string; tenantId?: string | null } };
+type Deps = HistoryMethods & {
+  validate(req: HistoryRequest): MessageRequestValidation;
+  sendValidationResponse(res: Response, result: FailedMessageValidationResult): Response;
+  previews(req: HistoryRequest): ReturnType<typeof prepareToolCallPreviews>;
+  logError(): void;
+};
+type ReadResult<T> = { ok: true; value: T } | { ok: false; error: unknown };
+const settleRead = <T>(read: Promise<T>): Promise<ReadResult<T>> =>
+  read.then(
+    (value) => ({ ok: true, value }),
+    (error: unknown) => ({ ok: false, error }),
+  );
+const cursor = z
+  .object({ createdAt: z.string().datetime(), position: z.string().regex(/^[a-f\d]{24}$/i) })
+  .strict();
+const querySchema = z
+  .object({
+    messageId: z.string().min(1).max(512).optional(),
+    limit: z.coerce
+      .number()
+      .int()
+      .min(1)
+      .max(MAX_HISTORY_PAGE_SIZE)
+      .default(DEFAULT_HISTORY_WINDOW_SIZE),
+    before: z
+      .string()
+      .max(1024)
+      .transform((text, ctx) => parseCursor(text, ctx))
+      .optional(),
+    since: z
+      .string()
+      .max(1024)
+      .transform((text, ctx) => parseCursor(text, ctx))
+      .optional(),
+  })
+  .refine(
+    (query) =>
+      !(query.before && query.since) && !(query.messageId && (query.before || query.since)),
+  );
+
+function parseCursor(text: string, ctx: z.RefinementCtx) {
+  try {
+    return cursor.parse(JSON.parse(text));
+  } catch {
+    ctx.addIssue({ code: z.ZodIssueCode.custom, message: 'Invalid history cursor' });
+    return z.NEVER;
+  }
+}
+
+/** Body references live only in the display projection, never in stored messages. */
+export function withAttachmentRefs(messages: TMessage[]): TMessage[] {
+  return messages.map((message) => ({
+    ...message,
+    attachments: message.attachments?.map((attachment, index) =>
+      attachment.type === Tools.web_search ||
+      attachment.type === Tools.file_search ||
+      !(attachment.filename || attachment.filepath || 'file_id' in attachment)
+        ? attachment
+        : {
+            ...attachment,
+            bodyRef: {
+              conversationId: message.conversationId ?? '',
+              messageId: message.messageId,
+              index,
+              revision: message.updatedAt ? new Date(message.updatedAt).toISOString() : '',
+            },
+          },
+    ),
+  }));
+}
+
+/** Validation and the user/tenant-scoped read overlap, but no data leaves before access settles. */
+export function createHistoryHandler(deps: Deps, windowed = false) {
+  return async (req: HistoryRequest, res: Response): Promise<void> => {
+    if (!req.user?.id) {
+      res.status(404).json({ error: 'Conversation not found' });
+      return;
+    }
+    const isWindowed = windowed || req.query.history === 'recent';
+    const parsed = isWindowed ? querySchema.safeParse(req.query) : undefined;
+    if (parsed && !parsed.success) {
+      res.status(400).json({ error: 'Invalid history request' });
+      return;
+    }
+    const page: HistoryOptions | undefined = parsed?.success ? parsed.data : undefined;
+    const lazyAttachments = isWindowed || req.query.attachmentBodies === 'lazy';
+    try {
+      const validation = deps.validate(req);
+      const preview = deps.previews(req);
+      const read = validation.shouldFetchMessages
+        ? deps.getDisplayMessages({
+            user: req.user.id,
+            tenantId: req.user.tenantId,
+            conversationId: req.params.conversationId,
+            lazyAttachments,
+            page,
+          })
+        : Promise.resolve({ messages: [], start: null, nextCursor: null });
+      const [access, settled] = await Promise.all([validation.promise, settleRead(read)]);
+      if (!access.ok) {
+        deps.sendValidationResponse(res, access);
+        return;
+      }
+      if (!settled.ok) throw settled.error;
+      const result = settled.value;
+      const messages = await preview(
+        lazyAttachments ? withAttachmentRefs(result.messages) : result.messages,
+      );
+      res.status(200).json(isWindowed ? { ...result, messages } : messages);
+    } catch {
+      deps.logError();
+      res.status(500).json({ error: 'Internal server error' });
+    }
+  };
+}
+
+export function createAttachmentBodyHandler(deps: Omit<Deps, 'previews'>) {
+  return async (req: HistoryRequest, res: Response): Promise<void> => {
+    if (!req.user?.id) {
+      res.status(404).json({ error: 'Attachment not found' });
+      return;
+    }
+    if (!/^\d+$/.test(req.params.index) || !Number.isSafeInteger(Number(req.params.index))) {
+      res.status(400).json({ error: 'Invalid attachment index' });
+      return;
+    }
+    const revision = z.string().datetime().optional().safeParse(req.query.revision);
+    if (!revision.success) {
+      res.status(400).json({ error: 'Invalid attachment revision' });
+      return;
+    }
+    try {
+      const validation = deps.validate(req);
+      const read = validation.shouldFetchMessages
+        ? deps.getHistoryAttachment({
+            user: req.user.id,
+            tenantId: req.user.tenantId,
+            conversationId: req.params.conversationId,
+            messageId: req.params.messageId,
+            index: Number(req.params.index),
+            revision: revision.data,
+          })
+        : Promise.resolve(null);
+      const [access, settled] = await Promise.all([validation.promise, settleRead(read)]);
+      if (!access.ok) {
+        deps.sendValidationResponse(res, access);
+        return;
+      }
+      if (!settled.ok) throw settled.error;
+      const body = settled.value;
+      if (!body) {
+        res.status(404).json({ error: 'Attachment not found' });
+        return;
+      }
+      res.setHeader('Cache-Control', 'private, no-store');
+      res.status(200).json(body);
+    } catch {
+      deps.logError();
+      res.status(500).json({ error: 'Internal server error' });
+    }
+  };
+}
