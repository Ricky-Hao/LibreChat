+  /** An explicit action may need one parent outside the loaded window. */
+  messageId?: string;
+  limit?: number;
+  before?: HistoryCursor;
+  /** Inclusive lower bound when revalidating an already loaded window. */
+  since?: HistoryCursor;
+};
+export type AttachmentBodyRef = {
+  conversationId: string;
+  messageId: string;
+  index: number;
+  revision: string;
+};
