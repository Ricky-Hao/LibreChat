+
+export interface TaskCallbackLifecycle {
+  handler: RequestHandler;
+  prepareContinue: NonNullable<AgentTriggerExecutionHostDeps['prepareContinue']>;
+  recover: () => Promise<boolean>;
+  initialize: () => Promise<void>;
+  stop: () => Promise<void>;
