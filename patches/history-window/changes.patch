+import mongoose from 'mongoose';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import type { HistoryCursor } from 'librechat-data-provider';
+import { createHistoryMethods } from './history';
+import { createMessageMethods } from './message';
+import { createModels } from '../models';
+
+let mongo: MongoMemoryServer;
+const scope = { user: 'history-owner', conversationId: 'history-fixture' };
+const methods = createHistoryMethods(mongoose);
+const body = 'Synthetic attachment body. '.repeat(16_384);
+
+beforeAll(async () => {
+  mongo = await MongoMemoryServer.create();
+  createModels(mongoose);
+  await mongoose.connect(mongo.getUri());
+  await mongoose.models.Message.init();
+});
+afterAll(async () => {
+  await mongoose.disconnect();
+  await mongo.stop();
+});
+beforeEach(async () => {
+  await mongoose.models.Message.deleteMany({});
+  await mongoose.models.Message.collection.insertMany(
+    Array.from({ length: 101 }, (_, i) => ({
+      ...scope,
+      messageId: String(i).padStart(4, '0'),
+      parentMessageId: String(i - 1).padStart(4, '0'),
+      createdAt: new Date(Date.UTC(2026, 0, 1, 0, 0, Math.floor(i / 3))),
+      updatedAt: new Date('2026-01-01'),
+      text: `Synthetic message ${i}`,
+      privateText: 'private',
+      attachments: [
+        { filename: 'synthetic.txt', text: body, textFormat: 'text', bytes: body.length },
+      ],
+      files: [{ file_id: 'uploaded', filename: 'upload.txt', text: body }],
+      summary: 'Synthetic model summary',
+    })),
+  );
+});
+
+test('pages backwards without skips or duplicates across tied timestamps, and projects bodies in Mongo', async () => {
+  let before: HistoryCursor | undefined;
+  const ids: string[] = [];
+  do {
+    const page = await methods.getDisplayMessages({
+      ...scope,
+      lazyAttachments: true,
+      page: { limit: 24, before },
+    });
+    expect(page.messages.length).toBeLessThanOrEqual(24);
+    expect(JSON.stringify(page)).not.toContain('Synthetic attachment body');
+    expect(JSON.stringify(page)).not.toContain('private');
+    ids.unshift(...page.messages.map((message) => message.messageId));
+    before = page.nextCursor ?? undefined;
+  } while (before);
+  expect(ids).toEqual(Array.from({ length: 101 }, (_, i) => String(i).padStart(4, '0')));
+  const full = await methods.getDisplayMessages({ ...scope, lazyAttachments: false });
+  expect(full.messages).toHaveLength(101);
+  expect(full.messages[0].attachments?.[0]).toHaveProperty('text', body);
+  expect(full.messages[0].files?.[0]).toHaveProperty('text', body);
+  const modelHistory = await createMessageMethods(mongoose).getMessages(scope);
+  expect(modelHistory).toHaveLength(101);
+  expect(modelHistory[0]).toMatchObject({
+    summary: 'Synthetic model summary',
+    attachments: [{ text: body }],
+  });
+  const plan = await mongoose.models.Message.collection
+    .find(scope)
+    .sort({ createdAt: -1, _id: -1 })
+    .limit(25)
+    .explain('executionStats');
+  expect(plan.executionStats.totalDocsExamined).toBeLessThanOrEqual(25);
+});
+
+test('revalidates the complete loaded span including new replies and deletions', async () => {
+  const page = await methods.getDisplayMessages({
+    ...scope,
+    lazyAttachments: true,
+    page: { limit: 24 },
+  });
+  await mongoose.models.Message.deleteOne({ ...scope, messageId: '0085' });
+  await mongoose.models.Message.collection.insertOne({
+    ...scope,
+    messageId: '0101',
+    parentMessageId: '0100',
+    createdAt: new Date('2026-01-02'),
+    text: 'New reply',
+  });
+  const refreshed = await methods.getDisplayMessages({
+    ...scope,
+    lazyAttachments: true,
+    page: { since: page.start! },
+  });
+  expect(refreshed.messages.map((message) => message.messageId)).toEqual([
+    ...page.messages.map((message) => message.messageId).filter((id) => id !== '0085'),
+    '0101',
+  ]);
+});
+
+test('scopes history and embedded bodies to the owner and exact tenant', async () => {
+  await mongoose.models.Message.collection.insertOne({
+    ...scope,
+    tenantId: 'other-tenant',
+    messageId: 'tenant-message',
+    createdAt: new Date('2026-01-03'),
+    attachments: [{ text: 'other tenant body' }],
+  });
+  expect(
+    (await methods.getDisplayMessages({ ...scope, lazyAttachments: true })).messages,
+  ).toHaveLength(101);
+  expect(
+    (
+      await methods.getDisplayMessages({
+        ...scope,
+        tenantId: 'other-tenant',
+        lazyAttachments: true,
+      })
+    ).messages,
+  ).toHaveLength(1);
+  expect(
+    (await methods.getDisplayMessages({ ...scope, user: 'stranger', lazyAttachments: true }))
+      .messages,
+  ).toEqual([]);
+  expect(await methods.getHistoryAttachment({ ...scope, messageId: '0002', index: 0 })).toEqual({
+    text: body,
+    textFormat: 'text',
+  });
+  expect(
+    await methods.getHistoryAttachment({ ...scope, user: 'stranger', messageId: '0002', index: 0 }),
+  ).toBeNull();
+  expect(
+    await methods.getHistoryAttachment({ ...scope, messageId: 'tenant-message', index: 0 }),
+  ).toBeNull();
+  expect(await methods.getHistoryAttachment({ ...scope, messageId: '0002', index: 1 })).toBeNull();
+  expect(
+    await methods.getHistoryAttachment({
+      ...scope,
+      messageId: '0002',
+      index: 0,
+      revision: '2025-01-01T00:00:00.000Z',
+    }),
+  ).toBeNull();
+});
diff --git a/packages/data-schemas/src/methods/history.ts b/packages/data-schemas/src/methods/history.ts
new file mode 100644
index 0000000000000000000000000000000000000000..70d216379bccefffa79663e993a1c07e12d49300
--- /dev/null
+++ b/packages/data-schemas/src/methods/history.ts
@@ -0,0 +1,87 @@
+import { DEFAULT_HISTORY_WINDOW_SIZE } from 'librechat-data-provider';
+import type {
+  HistoryCursor,
+  HistoryOptions,
+  HistoryPage,
+  TMessage,
+  TFilePreview,
+} from 'librechat-data-provider';
+import type { FilterQuery, Model, Mongoose, Types } from 'mongoose';
+import type { IMessage } from '~/types';
+import { CLIENT_MESSAGE_SELECT } from './message';
+
+export type HistoryScope = { user: string; conversationId: string; tenantId?: string | null };
+export type HistoryMethods = {
+  getDisplayMessages(
+    input: HistoryScope & { lazyAttachments: boolean; page?: HistoryOptions },
+  ): Promise<HistoryPage>;
+  getHistoryAttachment(
+    input: HistoryScope & { messageId: string; index: number; revision?: string },
+  ): Promise<Pick<TFilePreview, 'text' | 'textFormat'> | null>;
+};
+
+const scopeFilter = ({ user, conversationId, tenantId }: HistoryScope): FilterQuery<IMessage> => ({
+  user,
+  conversationId,
+  tenantId: tenantId ?? { $exists: false },
+});
+
+type HistoryRow = TMessage & { _id: Types.ObjectId };
+const cursorOf = (message?: HistoryRow): HistoryCursor | null =>
+  message?.createdAt == null
+    ? null
+    : { createdAt: new Date(message.createdAt).toISOString(), position: message._id.toString() };
+
+/** Indexed display reads; model context and exports continue to use the ordinary full reader. */
+export function createHistoryMethods(mongoose: Mongoose): HistoryMethods {
+  return {
+    async getDisplayMessages(input) {
+      const Message = mongoose.models.Message as Model<IMessage>;
+      const { page } = input;
+      const boundary = page?.before ?? page?.since;
+      const filter = scopeFilter(input);
+      if (page?.messageId) filter.messageId = page.messageId;
+      if (boundary) {
+        const time = new Date(boundary.createdAt);
+        const position = new mongoose.Types.ObjectId(boundary.position);
+        filter.$or = page?.before
+          ? [{ createdAt: { $lt: time } }, { createdAt: time, _id: { $lt: position } }]
+          : [{ createdAt: { $gt: time } }, { createdAt: time, _id: { $gte: position } }];
+      }
+      const bounded = page != null && page.since == null;
+      const limit = page?.limit ?? DEFAULT_HISTORY_WINDOW_SIZE;
+      const order = bounded ? -1 : 1;
+      const query = Message.find(filter)
+        .select(
+          `${CLIENT_MESSAGE_SELECT.replace('-_id', '')}${input.lazyAttachments ? ' -attachments.text -files.text' : ''}`,
+        )
+        .sort({ createdAt: order, _id: order });
+      if (bounded) query.limit(limit + 1);
+      const messages = await query.lean<HistoryRow[]>();
+      const hasMore = bounded && messages.length > limit;
+      if (hasMore) messages.pop();
+      if (bounded) messages.reverse();
+      const start = cursorOf(messages[0]);
+      return {
+        messages: messages.map(({ _id: _position, ...message }) => message),
+        start,
+        nextCursor: hasMore ? start : null,
+      };
+    },
+    async getHistoryAttachment(input) {
+      const Message = mongoose.models.Message as Model<IMessage>;
+      const [row] = await Message.aggregate<{ body?: Pick<TFilePreview, 'text' | 'textFormat'> }>([
+        {
+          $match: {
+            ...scopeFilter(input),
+            messageId: input.messageId,
+            ...(input.revision ? { updatedAt: new Date(input.revision) } : {}),
+          },
+        },
+        { $project: { body: { $arrayElemAt: ['$attachments', input.index] } } },
+        { $project: { 'body.text': 1, 'body.textFormat': 1 } },
+      ]);
+      return row?.body ?? null;
+    },
+  };
+}
