+
+  it('complete 替换临时 reasoning，保存调用和最终状态只含摘要正文', async () => {
+    class SummaryModel extends FakeChatModel {
+      constructor() {
+        super({ responses: ['unused'] });
+      }
+
+      async *_streamResponseChunks(): AsyncGenerator<ChatGenerationChunk> {
+        for (const chunk of [
