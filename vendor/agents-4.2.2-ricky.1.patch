+        source === 'steer' ||
+        source === 'hook' ||
+        source === 'system'
+          ? source
+          : 'unknown',
+      hasSkillId: typeof message.additional_kwargs.skillId === 'string',
+      hasSkillVersion:
+        typeof message.additional_kwargs.skillVersion === 'number',
+      blocks:
+        typeof message.content === 'string'
+          ? [{ type: 'text', phase: 'unknown' }]
