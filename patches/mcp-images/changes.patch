@@ -0,0 +1,429 @@
+const { createServer } = require('node:http');
+const { once } = require('node:events');
+const { randomUUID } = require('node:crypto');
+const mongoose = require('mongoose');
+const sharp = require('sharp');
+const { CallToolResultSchema } = require('@modelcontextprotocol/sdk/types.js');
+const {
+  createToolExecuteHandler,
+  getProviderConfig,
+  MCPConnection,
+  MCPManager,
+  MCPServersRegistry,
+} = require('@librechat/api');
+const { Constants, Permissions, PermissionTypes } = require('librechat-data-provider');
+const { getMCPManager, getMCPServersRegistry } = require('~/config');
+const db = require('~/models');
+const { getAppConfig, getMCPServerTools } = require('~/server/services/Config');
+const { getEndpointModelsConfig } = require('~/server/controllers/ModelController');
+const { saveBase64Image } = require('~/server/services/Files/process');
+const { createMCPTool } = require('~/server/services/MCP');
+const { initializeClient } = require('./initialize');
+
+jest.mock('~/config', () => ({
+  ...jest.requireActual('~/config'),
+  getMCPManager: jest.fn(),
+  getMCPServersRegistry: jest.fn(),
+}));
+jest.mock('~/models', () => ({
+  ...jest.requireActual('~/models'),
+  findPluginAuthsByKeys: jest.fn(async () => []),
+  getRoleByName: jest.fn(),
+}));
+jest.mock('~/server/controllers/ModelController', () => ({
+  getEndpointModelsConfig: jest.fn(),
+}));
+jest.mock('~/server/services/Config', () => ({
+  ...jest.requireActual('~/server/services/Config'),
+  getAppConfig: jest.fn(),
+  getMCPServerTools: jest.fn(),
+}));
+jest.mock('~/server/services/Files/process', () => ({
+  ...jest.requireActual('~/server/services/Files/process'),
+  saveBase64Image: jest.fn(),
+}));
+
+const responsesModel = 'gpt-6.2-sol';
+const moonshotModel = 'moonshot-v1-8k';
+const toolKey = `screenshot${Constants.mcp_delimiter}synthetic`;
+const callId = 'call_synthetic';
+const photoText = 'Synthetic screenshot is ready.';
+const endText = 'Finished synthetic tool call.';
+const prompt = 'Run the screenshot tool.';
+const toolDefinition = {
+  type: 'function',
+  function: {
+    name: toolKey,
+    description: 'Return a synthetic screenshot',
+    parameters: { type: 'object', properties: {} },
+  },
+};
+
+function writeResponsesStream(res, model, isFirstRequest) {
+  const item = isFirstRequest
+    ? { type: 'function_call', id: 'fc_synthetic', call_id: callId, name: toolKey, arguments: '{}' }
+    : {
+        type: 'message',
+        id: 'msg_synthetic',
+        role: 'assistant',
+        content: [{ type: 'output_text', text: endText, annotations: [] }],
+      };
+  const response = {
+    id: isFirstRequest ? 'resp_tool' : 'resp_final',
+    object: 'response',
+    model,
+    status: 'in_progress',
+    output: [],
+  };
+  const events = [{ type: 'response.created', response }];
+  if (isFirstRequest) {
+    events.push(
+      { type: 'response.output_item.added', output_index: 0, item: { ...item, arguments: '' } },
+      {
+        type: 'response.function_call_arguments.delta',
+        output_index: 0,
+        item_id: item.id,
+        delta: item.arguments,
+      },
+    );
+  } else {
+    events.push({
+      type: 'response.output_text.delta',
+      output_index: 0,
+      content_index: 0,
+      item_id: item.id,
+      delta: endText,
+    });
+  }
+  events.push({
+    type: 'response.completed',
+    response: {
+      ...response,
+      status: 'completed',
+      output: [{ ...item, status: 'completed' }],
+      usage: { input_tokens: 10, output_tokens: 5, total_tokens: 15 },
+    },
+  });
+  res.writeHead(200, { 'Content-Type': 'text/event-stream' });
+  res.end(
+    events.map((event) => `event: ${event.type}\ndata: ${JSON.stringify(event)}\n\n`).join(''),
+  );
+}
+
+function writeChatStream(res, model, isFirstRequest) {
+  const delta = isFirstRequest
+    ? {
+        tool_calls: [
+          { index: 0, id: callId, type: 'function', function: { name: toolKey, arguments: '{}' } },
+        ],
+      }
+    : { content: endText };
+  const chunk = {
+    id: isFirstRequest ? 'chat_tool' : 'chat_final',
+    object: 'chat.completion.chunk',
+    model,
+    choices: [{ index: 0, delta: { role: 'assistant', ...delta }, finish_reason: null }],
+  };
+  const done = {
+    ...chunk,
+    choices: [{ index: 0, delta: {}, finish_reason: isFirstRequest ? 'tool_calls' : 'stop' }],
+  };
+  res.writeHead(200, { 'Content-Type': 'text/event-stream' });
+  res.end(`data: ${JSON.stringify(chunk)}\n\ndata: ${JSON.stringify(done)}\n\ndata: [DONE]\n\n`);
+}
+
+function inputParts(input) {
+  return input.flatMap((item) => [
+    item,
+    ...[item.content, item.output].filter(Array.isArray).flat(),
+  ]);
+}
+
+describe('MCP images in the next Agent model request', () => {
+  let png;
+  let server;
+  let baseURL;
+  let requests;
+  let connection;
+  let callTool;
+  let image;
+  let serverConfig;
+  let config;
+
+  beforeAll(async () => {
+    png = (
+      await sharp({ create: { width: 2, height: 2, channels: 3, background: '#4287ab' } })
+        .png()
+        .toBuffer()
+    ).toString('base64');
+    image = { type: 'image', mimeType: 'image/png', data: png };
+    server = createServer(async (req, res) => {
+      const isResponses = req.url === '/v1/responses';
+      if (
+        req.method !== 'POST' ||
+        (!isResponses && req.url !== '/v1/chat/completions') ||
+        requests.length >= 2
+      ) {
+        res.writeHead(400).end();
+        return;
+      }
+      const chunks = [];
+      for await (const chunk of req) {
+        chunks.push(chunk);
+      }
+      const body = JSON.parse(Buffer.concat(chunks));
+      requests.push({ method: req.method, path: req.url, body });
+      const writeStream = isResponses ? writeResponsesStream : writeChatStream;
+      writeStream(res, body.model, requests.length === 1);
+    });
+    server.listen(0, '127.0.0.1');
+    await once(server, 'listening');
+    baseURL = `http://127.0.0.1:${server.address().port}/v1`;
+  });
+
+  afterAll(async () => {
+    if (server?.listening) {
+      const closed = once(server, 'close');
+      server.close();
+      server.closeAllConnections();
+      await closed;
+    }
+  });
+
+  beforeEach(() => {
+    requests = [];
+    serverConfig = { type: 'streamable-http', url: `${baseURL}/mcp` };
+    const registry = new MCPServersRegistry(mongoose, ['127.0.0.1'], ['127.0.0.1'], async () => ({
+      allowedDomains: ['127.0.0.1'],
+      allowedAddresses: ['127.0.0.1'],
+      mcpApps: registry.getMCPAppsPolicy(),
+      serverNames: ['synthetic'],
+    }));
+    registry.setYamlServerOptions({ synthetic: serverConfig });
+    jest.spyOn(registry, 'getServerConfig').mockImplementation(async (name) => {
+      return name === 'synthetic' ? serverConfig : undefined;
+    });
+    jest.spyOn(registry, 'getAllServerConfigs').mockResolvedValue({ synthetic: serverConfig });
+    jest.spyOn(registry, 'isAppServerConfig').mockResolvedValue(false);
+    jest.spyOn(registry, 'ensureConfigServers').mockResolvedValue({});
+    jest.spyOn(MCPServersRegistry, 'getInstance').mockReturnValue(registry);
+    getMCPServersRegistry.mockReturnValue(registry);
+    const manager = new MCPManager();
+    connection = new MCPConnection({ serverName: 'synthetic', serverConfig });
+    jest.spyOn(connection, 'isConnected').mockResolvedValue(true);
+    jest.spyOn(manager, 'getConnection').mockResolvedValue(connection);
+    callTool = jest.spyOn(manager, 'callTool');
+    getMCPManager.mockReturnValue(manager);
+    config = {
+      endpoints: {
+        agents: {
+          capabilities: ['tools'],
+          toolApproval: { enabled: false },
+          checkpointer: { enabled: false },
+        },
+        custom: [
+          {
+            name: 'NewAPI',
+            baseURL,
+            apiKey: 'test',
+            models: { default: [responsesModel], fetch: false },
+          },
+          {
+            name: 'Moonshot',
+            baseURL,
+            apiKey: 'test',
+            models: { default: [moonshotModel], fetch: false },
+          },
+        ],
+      },
+      mcpConfig: { synthetic: serverConfig },
+      mcpSettings: { allowedDomains: ['127.0.0.1'], allowedAddresses: ['127.0.0.1'] },
+      summarization: { enabled: false },
+      balance: { enabled: false },
+      transactions: { enabled: false },
+    };
+    getAppConfig.mockResolvedValue(config);
+    db.getRoleByName.mockResolvedValue({
+      permissions: { [PermissionTypes.MCP_SERVERS]: { [Permissions.USE]: true } },
+    });
+    getMCPServerTools.mockResolvedValue({ [toolKey]: toolDefinition });
+    saveBase64Image.mockResolvedValue({
+      file_id: 'synthetic-file',
+      type: 'image/png',
+      width: 2,
+      height: 2,
+      filepath: '/synthetic.png',
+    });
+  });
+
+  afterEach(() => jest.restoreAllMocks());
+
+  test.each([
+    ['NewAPI', 'image only', false, 'openAI', responsesModel, true],
+    ['NewAPI', 'Photo style', true, 'openAI', responsesModel, true],
+    ['openAI', 'image only', false, 'openAI', responsesModel, true],
+    ['Moonshot', 'image only', false, 'moonshot', moonshotModel, false],
+  ])(
+    '%s with %s through the direct Agent tool path',
+    async (endpoint, _label, photo, provider, model, useResponsesApi) => {
+      const response = CallToolResultSchema.parse(
+        photo
+          ? {
+              structuredContent: { width: 2, height: 2 },
+              content: [{ type: 'text', text: photoText }, image],
+            }
+          : { content: [image] },
+      );
+      const mcpRequest = jest.spyOn(connection.client, 'request').mockResolvedValue(response);
+      getEndpointModelsConfig.mockResolvedValue({ [endpoint]: [model] });
+      const openAIBaseURL = endpoint === 'openAI' ? baseURL : 'http://127.0.0.1:1/v1';
+      jest.replaceProperty(process, 'env', {
+        ...process.env,
+        OPENAI_API_KEY: 'test',
+        OPENAI_REVERSE_PROXY: openAIBaseURL,
+        OPENAI_BASE_URL: openAIBaseURL,
+      });
+      const conversationId = randomUUID();
+      const responseMessageId = randomUUID();
+      const toolEnd = jest.fn();
+      const req = {
+        user: { id: new mongoose.Types.ObjectId().toString(), role: 'USER' },
+        config,
+        body: { conversationId, endpoint: 'agents' },
+        resolvedConversation: null,
+        _agentEventActionObserver: toolEnd,
+      };
+      const res = { headersSent: true, writableEnded: false, write: jest.fn(), flush: jest.fn() };
+      const { client, userMCPAuthMap } = await initializeClient({
+        req,
+        res,
+        endpointOption: {
+          endpoint: 'agents',
+          model_parameters: { model },
+          agent: Promise.resolve({
+            id: 'synthetic-agent',
+            name: 'Synthetic Agent',
+            provider: endpoint,
+            model,
+            model_parameters: { useResponsesApi },
+            tools: [toolKey],
+          }),
+        },
+      });
+      client.conversationId = conversationId;
+      client.responseMessageId = responseMessageId;
+      await client.chatCompletion({
+        userMCPAuthMap,
+        payload: [
+          {
+            messageId: randomUUID(),
+            isCreatedByUser: true,
+            content: [{ type: 'text', text: prompt }],
+          },
+        ],
+      });
+
+      const path = useResponsesApi ? '/v1/responses' : '/v1/chat/completions';
+      expect(requests.map(({ method, path, body }) => [method, path, body.model])).toEqual([
+        ['POST', path, model],
+        ['POST', path, model],
+      ]);
+      const [firstRequest, secondRequest] = requests.map(({ body }) => body);
+      expect(
+        firstRequest.tools?.some((tool) => (tool.name ?? tool.function?.name) === toolKey),
+      ).toBe(true);
+      const firstInput = useResponsesApi ? firstRequest.input : firstRequest.messages;
+      expect(JSON.stringify(firstInput).includes(prompt)).toBe(true);
+      expect(
+        inputParts(firstInput).some(({ type }) => type === 'input_image' || type === 'image_url'),
+      ).toBe(false);
+      expect(mcpRequest).toHaveBeenCalledTimes(1);
+      expect(callTool).toHaveBeenCalledTimes(1);
+      const [, artifact] = await callTool.mock.results[0].value;
+      const nextInput = useResponsesApi ? secondRequest.input : secondRequest.messages;
+      const toolOutput = nextInput.find(
+        ({ type, role }) => type === 'function_call_output' || role === 'tool',
+      );
+      const parts = inputParts(nextInput);
+      const images = parts.filter(({ type }) => type === 'input_image' || type === 'image_url');
+      expect(toolOutput?.call_id ?? toolOutput?.tool_call_id).toBe(callId);
+      if (photo) {
+        expect(typeof toolOutput?.output).toBe('string');
+        expect(
+          toolOutput.output.includes(photoText) ||
+            parts.some(({ type, text }) => type === 'input_text' && text === photoText),
+        ).toBe(true);
+      }
+      const modelAcceptsImage = provider === 'openAI';
+      // Keep diagnostics limited to types, counts and booleans.
+      expect({
+        endpoint: client.options.agent.endpoint,
+        modelProvider: client.options.agent.provider,
+        mcpProvider: callTool.mock.calls[0][0].provider,
+        artifactContent: artifact?.content?.map(({ type }) => type),
+        imageAttachments: artifact?.imageAttachments?.length ?? 0,
+        imageParts: images.map(({ type, image_url }) => ({
+          type,
+          validPNG: image_url === `data:image/png;base64,${png}`,
+        })),
+      }).toEqual({
+        endpoint,
+        modelProvider: provider,
+        mcpProvider: provider.toLowerCase(),
+        artifactContent: modelAcceptsImage ? ['image_url'] : [],
+        imageAttachments: modelAcceptsImage ? 0 : 1,
+        imageParts: modelAcceptsImage ? [{ type: 'input_image', validPNG: true }] : [],
+      });
+      if (!modelAcceptsImage) {
+        expect(JSON.stringify(nextInput).includes(png)).toBe(false);
+      }
+      expect(toolEnd).toHaveBeenCalledTimes(1);
+    },
+  );
+
+  test('an explicit unknown invocation provider keeps the PNG attachment on the same MCP tool', async () => {
+    const user = { id: new mongoose.Types.ObjectId().toString(), role: 'USER' };
+    jest.spyOn(connection.client, 'request').mockResolvedValue(
+      CallToolResultSchema.parse({
+        content: [{ type: 'text', text: photoText }, image],
+      }),
+    );
+    // The app cannot initialize an unconfigured provider as an Agent model.
+    expect(() =>
+      getProviderConfig({ provider: 'unconfigured-provider', appConfig: config }),
+    ).toThrow();
+    const tool = await createMCPTool({
+      user,
+      config: serverConfig,
+      toolKey,
+      provider: 'openAI',
+      availableTools: { [toolKey]: toolDefinition },
+    });
+    const handler = createToolExecuteHandler({ loadTools: async () => ({ loadedTools: [tool] }) });
+    const invoke = (provider, id) =>
+      new Promise((resolve, reject) => {
+        handler.handle('on_tool_execute', {
+          toolCalls: [{ id, name: toolKey, args: {}, stepId: id }],
+          agentId: 'synthetic-agent',
+          metadata: { provider, thread_id: 'synthetic-thread', run_id: 'synthetic-message' },
+          configurable: { user },
+          resolve,
+          reject,
+        });
+      });
+    const [unknown] = await invoke('unconfigured-provider', 'call_unknown');
+    const [native] = await invoke(undefined, 'call_native');
+
+    expect(callTool.mock.calls.map(([options]) => options.provider)).toEqual([
+      'unconfigured-provider',
+      'openai',
+    ]);
+    expect(unknown.status).toBe('success');
+    expect(unknown.content === photoText).toBe(true);
+    expect(unknown.artifact.content.map(({ type }) => type)).toEqual([]);
+    expect(unknown.artifact.imageAttachments?.length).toBe(1);
+    expect(native.status).toBe('success');
+    expect(native.artifact.content.map(({ type }) => type)).toEqual(['image_url']);
+    expect(native.artifact.imageAttachments === undefined).toBe(true);
+  });
+});
