+import {
+  taskCallbackBodySchema,
+  taskCallbackConfigSchema,
+  redactTaskCallbackIds,
+} from './taskCallbacks';
+import { configSchema } from './config';
+
+describe('external task callback contract', () => {
+  it('defaults off and admits explicit deployment configuration', () => {
+    expect(taskCallbackConfigSchema.parse({})).toMatchObject({
+      enabled: false,
+      ttlMs: 86400000,
+      maxOutputBytes: 32768,
+    });
+    const config = configSchema.parse({
+      version: '1.3.8',
+      endpoints: {
+        agents: {
+          taskCallbacks: {
+            enabled: true,
+            publicUrl: 'https://chat.example/api/agents/task-callbacks',
+            ttlMs: 60000,
+          },
+        },
+      },
+    });
+    expect(config.endpoints?.agents?.taskCallbacks?.ttlMs).toBe(60000);
+    expect(taskCallbackConfigSchema.safeParse({ ttlMs: 0 }).success).toBe(false);
+    expect(taskCallbackConfigSchema.safeParse({ maxOutputBytes: 32769 }).success).toBe(false);
+  });
+  it('only admits the shared terminal protocol; display projection masks streamed prefixes', () => {
+    const body = {
+      version: 1,
+      callback_id: `tcb_${'a'.repeat(43)}`,
+      status: 'success',
+      output: 'done',
+    };
+    expect(taskCallbackBodySchema.parse(body)).toEqual(body);
+    for (const field of ['target', 'input', 'prompt', 'mode', 'metadata']) {
+      expect(taskCallbackBodySchema.safeParse({ ...body, [field]: 'untrusted' }).success).toBe(
+        false,
+      );
+    }
+    expect(redactTaskCallbackIds(`Task ${body.callback_id} finished; tcb_partial`)).toBe(
+      'Task [task callback] finished; [task callback]',
+    );
+  });
+});
diff --git a/packages/data-provider/src/taskCallbacks.ts b/packages/data-provider/src/taskCallbacks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e8c7cf527bf6d94c1647a95116e22ff10b566a04
--- /dev/null
+++ b/packages/data-provider/src/taskCallbacks.ts
@@ -0,0 +1,43 @@
+import { z } from 'zod';
+
+export const TASK_CALLBACK_OUTPUT_MAX_BYTES = 32_768;
+export const taskCallbackConfigSchema = z.object({
+  enabled: z.boolean().default(false),
+  publicUrl: z.string().url().optional(),
+  ttlMs: z.number().int().min(60_000).max(604_800_000).default(86_400_000),
+  receiptRetentionMs: z.number().int().min(86_400_000).max(7_776_000_000).default(604_800_000),
+  maxOutputBytes: z
+    .number()
+    .int()
+    .min(1)
+    .max(TASK_CALLBACK_OUTPUT_MAX_BYTES)
+    .default(TASK_CALLBACK_OUTPUT_MAX_BYTES),
+  requestsPerMinute: z.number().int().min(1).max(10_000).default(60),
+  recoveryIntervalMs: z.number().int().min(1000).max(300_000).default(30_000),
+  recoveryBatchSize: z.number().int().min(1).max(1000).default(25),
+  branchMessageLimit: z.number().int().min(10).max(10_000).default(2000),
+});
+
+export type TaskCallbackConfig = z.infer<typeof taskCallbackConfigSchema>;
+
+/** No routing, prompt, metadata, or execution controls cross this boundary. */
+export const taskCallbackBodySchema = z
+  .object({
+    version: z.literal(1),
+    callback_id: z.string().regex(/^tcb_[A-Za-z0-9_-]{43}$/),
+    status: z.enum(['success', 'error', 'cancelled']),
+    output: z.string().max(TASK_CALLBACK_OUTPUT_MAX_BYTES),
+  })
+  .strict();
+
+export type TaskCallbackBody = z.infer<typeof taskCallbackBodySchema>;
+export interface TaskCallbackReceipt {
+  version: 1;
+  receipt_id: string;
+  accepted_at: string;
+}
+
+/** Display/diagnostic projection only; model-bound tool traffic retains the bearer. */
+export function redactTaskCallbackIds(text: string): string {
+  return text.replace(/\btcb_[A-Za-z0-9_-]*/g, '[task callback]');
+}
