+      description: 'fixture',
+      schema: z.object({ id: z.string() }).strict(),
+      func: body,
+    });
+    const transparent = new Proxy(target, {
+      get: (tool, key) =>
+        key === 'invoke'
+          ? tool.invoke.bind(tool)
+          : Reflect.get(tool, key, tool),
+    });
+    const [success] = await executeTools(
